#!/usr/bin/env python3
"""Generate the probe_lab_api allowlist from the committed OpenAPI contract."""

from __future__ import annotations

import json
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parents[1]
OPENAPI = REPO / "docs/openapi/clockify-openapi.yaml"
OUT = REPO / "internal/tools/tier2_probe_lab_api_gen.go"

METHOD_CONST = {
    "get": "http.MethodGet",
    "post": "http.MethodPost",
    "put": "http.MethodPut",
    "patch": "http.MethodPatch",
    "delete": "http.MethodDelete",
}
METHOD_ORDER = {"get": 0, "post": 1, "put": 2, "patch": 3, "delete": 4}
MAIN_HOST = "https://api.clockify.me/api/v1"


def quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def go_strings(values: list[str]) -> str:
    cleaned = sorted({str(v) for v in values if str(v)})
    if not cleaned:
        return "nil"
    return "[]string{" + ", ".join(quote(v) for v in cleaned) + "}"


def main() -> None:
    doc = yaml.safe_load(OPENAPI.read_text())
    rows = []
    for path, item in sorted(doc.get("paths", {}).items()):
        for method, op in sorted(item.items(), key=lambda kv: METHOD_ORDER.get(kv[0], 99)):
            if method not in METHOD_CONST:
                continue
            tools = [
                tool
                for tool in op.get("x-clockify-mcp-tools", []) or []
                if not tool.startswith("clockify_call_documented_")
                and tool != "clockify_list_documented_api_operations"
            ]
            rows.append(
                {
                    "method": method,
                    "path": path,
                    "host": op.get("x-clockify-host") or MAIN_HOST,
                    "operation_id": op.get("operationId", ""),
                    "live_status": op.get("x-clockify-live-status", ""),
                    "risk": op.get("x-clockify-risk", []) or [],
                    "source_files": op.get("x-clockify-source-files", []) or [],
                    "promoted_to_typed": tools,
                }
            )

    lines = [
        "// Code generated by scripts/gen-probe-lab-allowlist; DO NOT EDIT.",
        "",
        "package tools",
        "",
        'import "net/http"',
        "",
        "var documentedAPIOperations = []documentedAPIOperation{",
    ]
    for row in rows:
        lines.append("\t{")
        lines.append(f"\t\tMethod:          {METHOD_CONST[row['method']]},")
        lines.append(f"\t\tPath:            {quote(row['path'])},")
        lines.append(f"\t\tHost:            {quote(row['host'])},")
        lines.append(f"\t\tOperationID:     {quote(row['operation_id'])},")
        lines.append(f"\t\tLiveStatus:      {quote(row['live_status'])},")
        lines.append(f"\t\tRiskClass:       {go_strings(row['risk'])},")
        lines.append(f"\t\tSourceFiles:     {go_strings(row['source_files'])},")
        lines.append(f"\t\tPromotedToTyped: {go_strings(row['promoted_to_typed'])},")
        lines.append("\t},")
    lines.append("}")
    lines.append("")
    OUT.write_text("\n".join(lines))


if __name__ == "__main__":
    main()
