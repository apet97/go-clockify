#!/usr/bin/env python3
"""Generate the OpenAPI ↔ MCP coverage matrix.

Joins:
  - docs/openapi/clockify-openapi.yaml (the contract)
  - docs/tool-catalog.json             (the MCP tool inventory)
  - docs/api-coverage.md               (tool → endpoint → test ledger)
  - internal/tools/tier2_probe_lab_api.go (raw documented-API allowlist)
  - tests/e2e_live*.go                 (live test → tool name index)

Outputs:
  - docs/openapi/coverage-matrix.json (machine-readable)
  - docs/openapi/coverage-matrix.md   (human-readable summary)

Re-run:
  python3 scripts/gen-coverage-matrix
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
OPENAPI = REPO / "docs/openapi/clockify-openapi.yaml"
CATALOG = REPO / "docs/tool-catalog.json"
COVERAGE_MD = REPO / "docs/api-coverage.md"
PROBE_GO = REPO / "internal/tools/tier2_probe_lab_api.go"
TESTS = sorted((REPO / "tests").glob("e2e_live*.go"))
OUT_JSON = REPO / "docs/openapi/coverage-matrix.json"
OUT_MD = REPO / "docs/openapi/coverage-matrix.md"

METHOD_RE = re.compile(
    r"\b(GET|POST|PUT|PATCH|DELETE)\s+"
    r"(https://(?:api|reports)\.clockify\.me(?:/api)?/v1)?"
    r"(/[^\s`|,)]+)",
    re.IGNORECASE,
)
TOOL_RE = re.compile(r"`(clockify_[A-Za-z0-9_]+)`")
TEST_RE = re.compile(r"`(Test[A-Za-z0-9_]+)`")
PROBE_OP_RE = re.compile(r'\{Method:\s+http\.Method(\w+),\s+Path:\s+"([^"]+)"')


def norm_path(p: str) -> str:
    p = p.strip()
    if not p.startswith("/"):
        p = "/" + p
    # collapse double slashes
    p = re.sub(r"/+", "/", p)
    return p.rstrip("/") if p != "/" else p


PLACEHOLDER_RE = re.compile(r"\{[A-Za-z][A-Za-z0-9_]*\}")
# Path segments that retain their specific placeholder name during canonical
# comparison because they identify a distinct relation (e.g. user-scoped time
# entries differ from policy-scoped requests).
SPECIFIC_PLACEHOLDERS = {
    "{workspaceId}",
    "{userId}",
    "{addonId}",
    "{policyId}",  # keep when nested under another id (handled below)
}


def canon_path(p: str) -> str:
    """Canonicalize path so that `{policyId}` ≡ `{id}` for coverage matching.

    Workspace, user, and addon placeholders stay specific because they
    identify the enclosing scope; the api-coverage.md shorthand `{ws}`
    and `{uid}` is mapped onto the OpenAPI form. Everything else
    collapses to `{id}` so spec (`/projects/{projectId}`) and allowlist
    (`/projects/{id}`) agree.
    """
    parts = []
    for seg in p.split("/"):
        if seg in {"{workspaceId}", "{ws}"}:
            parts.append("{workspaceId}")
            continue
        if seg in {"{userId}", "{uid}"}:
            parts.append("{userId}")
            continue
        if seg in {"{addonId}"}:
            parts.append(seg)
            continue
        if PLACEHOLDER_RE.fullmatch(seg or ""):
            parts.append("{id}")
        else:
            parts.append(seg)
    return "/".join(parts)


def parse_coverage_md() -> dict[tuple[str, str], list[dict]]:
    """Return {(method,path): [{tool, tests}, …]}.

    Captures three idioms used in docs/api-coverage.md:

    1. Single line carrying both `clockify_xxx` and `METHOD /path`
       (the read-only and mutating tier-1 tables).
    2. Per-section prose like "Clockify endpoints: GET /a, POST /b, …"
       followed by a Markdown table whose rows list `clockify_xxx` tools.
       The endpoints fan out across every tool in the following table
       until the next H3 (`### `) header or a horizontal rule (`---`).
    3. Path fragments (`/scheduling/assignments/recurring`) without an
       explicit method — those expand to the union of HTTP methods that
       the section's tool names imply (`create_` → POST, `list_`/`get_`
       → GET, `update_` → PUT, `delete_` → DELETE).
    """
    mapping: dict[tuple[str, str], list[dict]] = {}
    text = COVERAGE_MD.read_text()
    lines = text.splitlines()
    # First pass — direct line matches.
    for line in lines:
        if "clockify_" not in line:
            continue
        tools = TOOL_RE.findall(line)
        if not tools:
            continue
        tests = TEST_RE.findall(line)
        for m in METHOD_RE.finditer(line):
            method = m.group(1).lower()
            path = canon_path(norm_path(m.group(3)))
            key = (method, path)
            for tool in tools:
                mapping.setdefault(key, []).append(
                    {"tool": tool, "tests": tests}
                )
    # Second pass — section-scoped fan-out.
    section_re = re.compile(r"^###\s+`([^`]+)`\s*\(\d+\s*tools?\)")
    bare_path_re = re.compile(r"`(/[^`]+)`")
    explicit_re = re.compile(r"\b(GET|POST|PUT|PATCH|DELETE)\s+(/[^\s`,]+)")
    i = 0
    while i < len(lines):
        line = lines[i]
        sm = section_re.match(line)
        if not sm:
            i += 1
            continue
        # Collect prose endpoints + tool list until next H3 or HR.
        endpoints: list[tuple[str | None, str]] = []
        tools_in_section: set[str] = set()
        tests_in_section: dict[str, set[str]] = {}
        j = i + 1
        while j < len(lines):
            ln = lines[j]
            if ln.startswith("### ") or ln.strip() == "---":
                break
            for em in explicit_re.finditer(ln):
                endpoints.append((em.group(1).lower(), canon_path(norm_path(em.group(2)))))
            for bm in bare_path_re.finditer(ln):
                p = bm.group(1)
                if "/" in p and not p.startswith("//"):
                    endpoints.append((None, canon_path(norm_path(p))))
            for tm in TOOL_RE.findall(ln):
                tools_in_section.add(tm)
                for testname in TEST_RE.findall(ln):
                    tests_in_section.setdefault(tm, set()).add(testname)
            j += 1
        # Fan out endpoints across the tools whose names hint a method.
        method_hints = {
            "list_": "get",
            "get_": "get",
            "list-": "get",
            "find_": "get",
            "create_": "post",
            "add_": "post",
            "update_": "put",
            "set_": "patch",
            "delete_": "delete",
            "archive_": "put",
        }

        def method_of(tool_name: str) -> set[str]:
            for prefix, m in method_hints.items():
                if prefix in tool_name:
                    return {m}
            return {"get", "post", "put", "patch", "delete"}

        for method, path in endpoints:
            for tool in tools_in_section:
                methods = {method} if method else method_of(tool)
                tests = sorted(tests_in_section.get(tool, set()))
                for m in methods:
                    key = (m, path)
                    mapping.setdefault(key, []).append(
                        {"tool": tool, "tests": tests}
                    )
        i = j
    return mapping


def parse_allowlist() -> set[tuple[str, str]]:
    text = PROBE_GO.read_text()
    out: set[tuple[str, str]] = set()
    for m in PROBE_OP_RE.finditer(text):
        out.add((m.group(1).lower(), canon_path(norm_path(m.group(2)))))
    return out


def parse_test_tools() -> dict[str, set[str]]:
    """Return {tool_name: {test_func, …}}."""
    out: dict[str, set[str]] = {}
    func_re = re.compile(r"^func\s+(Test[A-Za-z0-9_]+)\s*\(")
    call_re = re.compile(r'"(clockify_[A-Za-z0-9_]+)"')
    for path in TESTS:
        current: str | None = None
        for line in path.read_text().splitlines():
            fm = func_re.match(line)
            if fm:
                current = fm.group(1)
                continue
            if not current:
                continue
            for tm in call_re.finditer(line):
                out.setdefault(tm.group(1), set()).add(current)
    return out


def load_openapi() -> list[dict]:
    spec = yaml.safe_load(OPENAPI.read_text())
    ops = []
    for raw_path, methods in spec.get("paths", {}).items():
        path = norm_path(raw_path)
        for method, op in methods.items():
            if not isinstance(op, dict) or method not in (
                "get",
                "post",
                "put",
                "patch",
                "delete",
                "head",
                "options",
            ):
                continue
            ops.append(
                {
                    "operationId": op.get("operationId", ""),
                    "method": method,
                    "path": path,
                    "summary": op.get("summary", ""),
                    "tag": (op.get("tags") or [""])[0],
                    "mcp_tools": op.get("x-clockify-mcp-tools") or [],
                    "live_status": op.get("x-clockify-live-status", ""),
                    "evidence": op.get("x-clockify-evidence") or [],
                    "risk": op.get("x-clockify-risk") or [],
                    "host": op.get("x-clockify-host", ""),
                    "notes": op.get("x-clockify-notes") or [],
                }
            )
    return ops


def coverage_status(row: dict) -> str:
    """Single-token coverage class for sorting.

    A live-test invocation of any mapped typed tool is treated as live
    evidence even if the OpenAPI x-clockify-live-status string is still
    `unit-only` — the live test grep is the authoritative signal here.
    """
    if row["live_test_names"]:
        return "live-success"
    if row["live_status"] == "live-success":
        return "live-success"
    if row["live_status"] in ("permission-gated", "workspace-state-limited"):
        return row["live_status"]
    if row["live_status"] == "unsupported":
        return "unsupported"
    if row["typed_tools"] or row["coverage_md_tools"]:
        return "typed-tool-mapped"
    if row["raw_allowlisted"]:
        return "raw-tool-only"
    return "uncovered"


def build_rows(
    ops, coverage_map, allowlist, test_tools
) -> list[dict]:
    catalog = json.loads(CATALOG.read_text())
    tool_names = {
        t["name"]: t for t in catalog.get("tier1", []) + catalog.get("tier2", [])
    }
    rows = []
    for op in ops:
        key = (op["method"], canon_path(op["path"]))
        coverage_entries = coverage_map.get(key, [])
        coverage_tools = sorted({e["tool"] for e in coverage_entries})
        coverage_tests = sorted(
            {t for e in coverage_entries for t in e["tests"]}
        )
        typed_tools = sorted(
            set(op["mcp_tools"]) | set(coverage_tools)
        )
        live_test_names = sorted(
            {t for tool in typed_tools for t in test_tools.get(tool, set())}
        )
        # raw API allowlist match (canonicalized)
        raw = (op["method"], canon_path(op["path"])) in allowlist
        row = {
            "operationId": op["operationId"],
            "method": op["method"].upper(),
            "path": op["path"],
            "host": op["host"],
            "tag": op["tag"],
            "summary": op["summary"],
            "typed_tools": typed_tools,
            "coverage_md_tools": coverage_tools,
            "live_test_names": live_test_names,
            "raw_allowlisted": raw,
            "live_status": op["live_status"],
            "evidence": op["evidence"],
            "risk": op["risk"],
            "notes_count": len(op["notes"]),
            "typed_tools_in_catalog": [
                t for t in typed_tools if t in tool_names
            ],
            "typed_tools_orphan": [
                t for t in typed_tools if t not in tool_names
            ],
        }
        row["coverage_class"] = coverage_status(row)
        rows.append(row)
    return rows


def summarize(rows: list[dict]) -> dict:
    by_class: dict[str, int] = {}
    by_tag: dict[str, dict[str, int]] = {}
    no_mcp_tool: list[dict] = []
    no_evidence: list[dict] = []
    for r in rows:
        by_class[r["coverage_class"]] = by_class.get(r["coverage_class"], 0) + 1
        bt = by_tag.setdefault(r["tag"] or "", {})
        bt[r["coverage_class"]] = bt.get(r["coverage_class"], 0) + 1
        if not r["typed_tools"] and not r["raw_allowlisted"]:
            no_mcp_tool.append(r)
        if not r["evidence"]:
            no_evidence.append(r)
    return {
        "total": len(rows),
        "by_class": by_class,
        "by_tag": by_tag,
        "no_mcp_tool_count": len(no_mcp_tool),
        "no_evidence_count": len(no_evidence),
    }


def render_markdown(rows: list[dict], summary: dict, catalog_meta: dict) -> str:
    lines = ["# Clockify OpenAPI ↔ MCP coverage matrix", ""]
    lines.append(
        "Autogenerated by `scripts/gen-coverage-matrix`. Do not edit by hand. "
        "Re-run after the OpenAPI, tool catalog, api-coverage ledger, "
        "probe-lab allowlist, or live tests change."
    )
    lines.append("")
    lines.append("## Summary")
    lines.append("")
    lines.append(f"- Operations in OpenAPI: **{summary['total']}**")
    for cls, n in sorted(
        summary["by_class"].items(), key=lambda kv: -kv[1]
    ):
        lines.append(f"  - `{cls}`: {n}")
    lines.append(
        f"- Operations with **no** MCP tool **and** no raw-allowlist hit: "
        f"**{summary['no_mcp_tool_count']}** (must be zero for an exhaustive surface)."
    )
    lines.append("")
    lines.append("## Per-tag rollup")
    lines.append("")
    lines.append("| Tag | total | live-success | typed-tool-mapped | raw-tool-only | other |")
    lines.append("|-----|------:|-------------:|------------------:|--------------:|------:|")
    other_classes = (
        "permission-gated",
        "workspace-state-limited",
        "unsupported",
        "uncovered",
    )
    for tag, classes in sorted(summary["by_tag"].items()):
        total = sum(classes.values())
        live = classes.get("live-success", 0)
        typed = classes.get("typed-tool-mapped", 0)
        raw = classes.get("raw-tool-only", 0)
        other = sum(classes.get(c, 0) for c in other_classes)
        lines.append(
            f"| {tag or '(none)'} | {total} | {live} | {typed} | {raw} | {other} |"
        )
    lines.append("")
    lines.append("## Operations not covered by any MCP tool")
    lines.append("")
    flagged = [
        r for r in rows if not r["typed_tools"] and not r["raw_allowlisted"]
    ]
    if not flagged:
        lines.append("_None — every OpenAPI operation has at least a raw documented-API allowlist match._")
    else:
        lines.append("| Method | Path | operationId | tag | live-status |")
        lines.append("|--------|------|-------------|-----|-------------|")
        for r in flagged:
            lines.append(
                f"| {r['method']} | `{r['path']}` | {r['operationId']} | {r['tag']} | {r['live_status']} |"
            )
    lines.append("")
    lines.append("## Detail")
    lines.append("")
    lines.append("Full row JSON lives in [coverage-matrix.json](coverage-matrix.json).")
    return "\n".join(lines) + "\n"


def main() -> int:
    coverage_map = parse_coverage_md()
    allowlist = parse_allowlist()
    test_tools = parse_test_tools()
    ops = load_openapi()
    rows = build_rows(ops, coverage_map, allowlist, test_tools)
    summary = summarize(rows)
    catalog = json.loads(CATALOG.read_text())
    catalog_meta = {
        "tier1": len(catalog.get("tier1", [])),
        "tier2": len(catalog.get("tier2", [])),
    }
    payload = {
        "generated_by": "scripts/gen-coverage-matrix",
        "openapi_version": yaml.safe_load(OPENAPI.read_text())["info"]["version"],
        "openapi_op_count": len(rows),
        "tool_catalog": catalog_meta,
        "raw_allowlist_count": len(allowlist),
        "summary": summary,
        "rows": rows,
    }
    OUT_JSON.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    OUT_MD.write_text(render_markdown(rows, summary, catalog_meta))
    print(
        f"wrote {OUT_JSON.relative_to(REPO)} and "
        f"{OUT_MD.relative_to(REPO)} "
        f"({len(rows)} ops, {summary['no_mcp_tool_count']} uncovered)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
