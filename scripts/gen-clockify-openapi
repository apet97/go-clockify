  ["patch",  "/workspaces/{workspaceId}/webhooks/{webhookId}/generateNewToken"]             => {group: "webhooks", name: "rotateToken"},
  ["get",    "/workspaces/{workspaceId}/webhooks/{webhookId}/logs"]                         => {group: "webhooks", name: "listLogs"},
  ["post",   "/workspaces/{workspaceId}/webhooks/{webhookId}/logs"]                         => {group: "webhooks", name: "searchLogs"},
  ["patch",  "/workspaces/{workspaceId}/webhooks/{webhookId}/token"]                        => {group: "webhooks", name: "updateToken"},
  # expenses — receipt download (binary file).
  ["get",    "/workspaces/{workspaceId}/expenses/{expenseId}/files/{fileId}"]               => {group: "expenses", name: "downloadReceipt"},
  # scheduling — per-project + per-user capacity views, plus the PUT
  # replace variant for recurring assignments.
  ["post",   "/workspaces/{workspaceId}/scheduling/assignments/projects/totals"]                  => {group: "scheduling", name: "listPerProject"},
  ["get",    "/workspaces/{workspaceId}/scheduling/assignments/projects/totals/{projectId}"]      => {group: "scheduling", name: "listOnProject"},
  ["put",    "/workspaces/{workspaceId}/scheduling/assignments/recurring/{assignmentId}"]         => {group: "scheduling", name: "replaceRecurring"},
  ["post",   "/workspaces/{workspaceId}/scheduling/assignments/user-filter/totals"]               => {group: "scheduling", name: "getUsersCapacityFiltered"},
  ["post",   "/workspaces/{workspaceId}/scheduling/assignments/users/totals"]                     => {group: "scheduling", name: "calculateUsersTotals"},
  ["get",    "/workspaces/{workspaceId}/scheduling/assignments/users/{userId}/totals"]            => {group: "scheduling", name: "getUserCapacity"},
  # timeOff — admin submits a TOR on behalf of a specific user.
  ["post",   "/workspaces/{workspaceId}/time-off/policies/{policyId}/users/{userId}/requests"]    => {group: "timeOff", name: "submitForUser"},
  # Remaining small / read-only / single-resource modules (G.1 final
  # batch). Each stamp here uses the obvious domain verb so the SDK
  # surface across all 21 stamped modules is uniformly idiomatic.
  # Modules where the existing operationId is already a clean
  # verb-noun (files.uploadImage, expenseReport.generateDetailedReportV1)
  # are intentionally left operationId-derived -- the rename would
  # not improve clarity. The user manager-role grant/revoke ops are
  # stamped under `users` below (giveRole/removeRole).

  # auditLogReport — single search op (POST .../audit-log with body).
  ["post",   "/workspaces/{workspaceId}/audit-log"]                                 => {group: "auditLogReport", name: "search"},
  # balances — policy-scoped list + user-scoped get + policy-scoped
  # update. The two paginated routes (GET .../policy/{pid} and
  # GET .../user/{uid}) live here because the upstream tag is
  # `Balances`; the PATCH-on-policy route is balance adjustment.
  ["get",    "/workspaces/{workspaceId}/time-off/balance/policy/{policyId}"]        => {group: "balances", name: "listForPolicy"},
  ["patch",  "/workspaces/{workspaceId}/time-off/balance/policy/{policyId}"]        => {group: "balances", name: "update"},
  ["get",    "/workspaces/{workspaceId}/time-off/balance/user/{userId}"]            => {group: "balances", name: "getForUser"},
  # entityChangesExperimental — three read ops for the change-event
  # feed; one per event type (created / updated / deleted).
  ["get",    "/workspaces/{workspaceId}/entities/created"]                          => {group: "entityChangesExperimental", name: "listCreated"},
  ["get",    "/workspaces/{workspaceId}/entities/updated"]                          => {group: "entityChangesExperimental", name: "listUpdated"},
  ["get",    "/workspaces/{workspaceId}/entities/deleted"]                          => {group: "entityChangesExperimental", name: "listDeleted"},
  # invoiceSettings — single-resource get + update.
  ["get",    "/workspaces/{workspaceId}/invoices/settings"]                         => {group: "invoiceSettings", name: "get"},
  ["put",    "/workspaces/{workspaceId}/invoices/settings"]                         => {group: "invoiceSettings", name: "update"},
  # memberProfiles — per-user profile read + partial update.
  ["get",    "/workspaces/{workspaceId}/member-profile/{userId}"]                   => {group: "memberProfiles", name: "get"},
  ["patch",  "/workspaces/{workspaceId}/member-profile/{userId}"]                   => {group: "memberProfiles", name: "update"},
  # users — workspace user listing plus manager-role grant/revoke. The
  # role verbs live under `users` (matching how Clockify/Go scope role
  # writes to a user) rather than a one-method `roles` module.
  ["get",    "/workspaces/{workspaceId}/users"]                                     => {group: "users", name: "list"},
  ["post",   "/workspaces/{workspaceId}/users/{userId}/roles"]                      => {group: "users", name: "giveRole"},
  ["delete", "/workspaces/{workspaceId}/users/{userId}/roles"]                      => {group: "users", name: "removeRole"},
  # workspaces — CRUDL on the workspace resource itself, plus the two
  # workspace-level rate updates and the addUser action verb. Per-user
  # status / cost-rate / hourly-rate are kept operationId-derived
  # (already verb-noun shaped; `client.workspaces.updateUserStatus`
  # etc. read fine as-is).
  ["get",    "/workspaces"]                                                         => {group: "workspaces", name: "list"},
  ["post",   "/workspaces"]                                                         => {group: "workspaces", name: "create"},
  ["get",    "/workspaces/{workspaceId}"]                                           => {group: "workspaces", name: "get"},
  ["put",    "/workspaces/{workspaceId}"]                                           => {group: "workspaces", name: "update"},
  ["put",    "/workspaces/{workspaceId}/cost-rate"]                                 => {group: "workspaces", name: "updateCostRate"},
  ["put",    "/workspaces/{workspaceId}/hourly-rate"]                               => {group: "workspaces", name: "updateBillableRate"},
  ["post",   "/workspaces/{workspaceId}/users"]                                     => {group: "workspaces", name: "addUser"},
  # Final domain edge-case fills (G.1 step 8). Each one is the result
  # of a per-op naming review where the operationId verb did not have
  # an obvious one-word equivalent until we looked at the HTTP-method
  # contrast with a sibling op:
  # - projects POST /memberships replaces the membership list (vs
  #   the sibling PATCH which we stamped as `updateMemberships`).
  #   Naming `setMembers` mirrors the userGroups membership family
  #   (`listMembers`, `addMembers`, `removeMember`).
  # - timeOff DELETE on the policy-scoped request path is the user-
  #   side withdraw flow (admin DELETE on the workspace-level
  #   `/time-off/requests/{rid}` was stamped as `delete`).
  # - The third v0.5.0 edge-case stamp (`balances.listForUser` on GET
  #   /users/{userId}/time-off/balances) was removed in the
  #   2026-05-25 follow-up after the route was confirmed phantom on
  #   the live API (HTTP 404 + code 3000). That path now lives in
  #   PHANTOM_PATHS; the live per-user balance read is the singular
  #   `/time-off/balance/user/{userId}` (already stamped as
  #   `balances.getForUser`).
  ["post",   "/workspaces/{workspaceId}/projects/{projectId}/memberships"]                        => {group: "projects", name: "setMembers"},
  ["delete", "/workspaces/{workspaceId}/time-off/policies/{policyId}/requests/{requestId}"]       => {group: "timeOff", name: "withdraw"}
}.freeze

def stamp_sdk_method_name!(op, method, path)
  entry = SDK_METHOD_NAMES[[method.to_s, path.to_s]]
  return unless entry

  op["x-fern-sdk-group-name"] = entry[:group]
  op["x-fern-sdk-method-name"] = entry[:name]
end

# Resolve a parameter's field ("in", "name", ...) whether the parameter is
# inline or a $ref into #/components/parameters. params_components is the merged
# @components["parameters"] map (keyed by ref tail). Returns nil when it cannot
# be resolved so callers can fall back to their inline handling.
def resolve_param_field(param, params_components, field)
  return param[field] if param.is_a?(Hash) && param.key?(field)

  ref = param.is_a?(Hash) ? param["$ref"].to_s : ""
  return nil unless ref.start_with?("#/components/parameters/")

  tail = ref.split("/").last
  comp = params_components.is_a?(Hash) ? params_components[tail] : nil
  comp.is_a?(Hash) ? comp[field] : nil
end

# Wire name a parameter binds to. For a $ref this is the component's own
# `name`, NOT the ref tail: a component keyed `Order` can declare parameter
# `order`, and matching on the tail dropped it as if it were unrelated to the
# `{order}` placeholder — after which ensure_path_parameters! backfilled a
# bare `type: string`, silently discarding the component's `integer/int32,
# minimum: 1` typing. Falls back to the tail when the component is absent.
def path_binding_name(param, params_components)
  resolve_param_field(param, params_components, "name") || parameter_name(param)
end

def ensure_path_parameters!(op, path, params_components = {})
  wanted = path.scan(/\{([^}]+)\}/).flatten
  existing = Array(op["parameters"]).select do |param|
    # Non-path parameters (query/header/cookie: start/end, page, page-size,
    # sort-order, ...) are never placeholder-bound, so they always survive.
    resolved_in = param.is_a?(Hash) ? resolve_param_field(param, params_components, "in") : nil
    next true if resolved_in && resolved_in != "path"

    name = path_binding_name(param, params_components)
    name.nil? || wanted.include?(name)
  end
  seen = existing.each_with_object(Set.new) do |param, set|
    name = path_binding_name(param, params_components)
    next unless name

    set << name
  end
  wanted.each do |name|
    next if seen.include?(name)

    existing << {
      "name" => name,
      "in" => "path",
      "required" => true,
      "schema" => {"type" => "string"}
    }
    seen << name
  end
  op["parameters"] = existing unless existing.empty?
end

def json_pointer_exists?(doc, ref)
  return false unless ref.start_with?("#/")

  current = doc
  ref.sub("#/", "").split("/").each do |raw|
    token = raw.gsub("~1", "/").gsub("~0", "~")
    return false unless current.is_a?(Hash) && current.key?(token)

    current = current[token]
  end
  true
end

class Merger
  attr_reader :quarantine

  def initialize(options)
    @options = options
    @operations = {}
    @components = Hash.new { |h, key| h[key] = {} }
    @component_hashes = Hash.new { |h, key| h[key] = {} }
    @quarantine = []
    @used_operation_ids = Set.new
    @aliases = Set.new
    @security_header_aliases = Hash.new { |h, key| h[key] = Set.new }
  end

  def add_yaml_file(path, kind)
    doc = load_yaml_file(path)
    return unless doc.is_a?(Hash)

    label = source_label(path, @options)
    domain = domain_from_path(path)
    servers = Array(doc["servers"]).map { |server| server["url"].to_s }
    security_schemes = doc.dig("components", "securitySchemes") || {}
    collect_security_aliases(security_schemes)
    ref_maps = merge_components(doc["components"] || {}, domain)
    Array(doc.dig("components", "securitySchemes")).each { |scheme| @aliases << scheme[0].to_s if scheme[0].to_s != "ApiKeyAuth" }

    paths = doc["paths"] || {}
    paths.keys.sort.each do |raw_path|
      item = paths[raw_path]
      next unless item.is_a?(Hash)

      inherited_parameters = Array(item["parameters"])
      item.keys.map(&:to_s).select { |m| METHODS.include?(m.downcase) }.sort_by { |m| METHOD_ORDER.fetch(m.downcase, 99) }.each do |method|
        op = deep_copy(item[method])
        op["parameters"] = merge_parameters(inherited_parameters, Array(op["parameters"]))
        aliases = operation_security_aliases(op, security_schemes)
        op["x-clockify-security-aliases"] = aliases unless aliases.empty?
        rewrite_refs!(op, ref_maps)
        normalize_security!(op, @aliases)
        normalized = normalize_path(raw_path)
        host = host_for(normalized, op, servers)
        add_operation(
          method.downcase,
          normalized,
          op,
          source: label,
          domain: domain,
          host: host,
          evidence: kind,
          priority: SOURCE_PRIORITIES.fetch(kind, 0)
        )
      end
    end
  rescue StandardError => e
    reason = if defined?(Psych::SyntaxError) && e.is_a?(Psych::SyntaxError)
               "invalid YAML source quarantined"
             else
               e.message.lines.first.to_s.strip.gsub(File.expand_path(path), source_label(path, @options))
             end
    @quarantine << {
      "source" => source_label(path, @options),
      "reason" => reason
    }
  end

  def add_markdown_doc(path)
    label = source_label(path, @options)
    domain = domain_from_path(path)
    method_path_from_doc(File.readlines(path, chomp: true)).each do |method, normalized|
      op = {
        "tags" => [tag_for_domain(domain)],
        "summary" => "Documented #{method.upcase} #{normalized}",
        "description" => "Operation discovered from pasted Clockify API Markdown. Schemas stay broad unless a parsed OpenAPI source or live fixture provides narrower structure.",
        "operationId" => operation_id(method, normalized, @used_operation_ids),
        "security" => [{"ApiKeyAuth" => []}, {"AddonTokenAuth" => []}],
        "responses" => {
          "default" => {
            "description" => "Documented Clockify response.",
            "content" => {
              "application/json" => {
                "schema" => {"type" => "object", "additionalProperties" => true}
              }
            }
          }
        }
      }
      add_operation(
        method,
        normalized,
        op,
        source: label,
        domain: domain,
        host: host_for(normalized, op, []),
        evidence: "doc-md",
        priority: SOURCE_PRIORITIES.fetch("doc-md")
      )
    end
  end

  def apply_metadata(findings, mcp_mapping, tool_risks, tool_meta)
    @operations.each do |(method, path), record|
      op = record[:op]
      findings_for_op = Array(findings[[method, path, record[:host]]]) + Array(findings[[method, path, nil]])
      other_host_findings = findings.each_with_object([]) do |((f_method, f_path, f_host), values), out|
        next unless f_method == method && f_path == path && f_host && f_host != record[:host]

        out.concat(values)
      end
      evidence = Array(op["x-clockify-evidence"])
      source_files = Array(op["x-clockify-source-files"])
      source_live_status = op["x-clockify-live-status"].to_s
      findings_for_op.each do |finding|
        evidence << finding["bucket"]
        source_files << finding["source"]
      end
      live_status = choose_live_status(evidence, findings_for_op, [source_live_status])
      tools = Array(mcp_mapping[[method, path]]).sort
      evidence.concat(tools.flat_map { |tool| Array(tool_meta.dig(tool, "evidence")) })
      tool_statuses = tools.flat_map { |tool| Array(tool_meta.dig(tool, "statuses")) }
      live_status = choose_live_status(evidence, findings_for_op, [source_live_status] + tool_statuses)
      risk = tools.flat_map { |tool| tool_risks[tool] }.compact
      risk = Array(op["x-clockify-risk"]) if risk.empty? && Array(op["x-clockify-risk"]).any?
      risk = default_risk_for(method) if risk.empty?

      op["x-clockify-source-files"] = source_files.uniq.sort
      op["x-clockify-host"] = record[:host]
      op["x-clockify-evidence"] = evidence.uniq.sort
      op["x-clockify-live-status"] = live_status
      op["x-clockify-mcp-tools"] = tools
      op["x-clockify-risk"] = risk.uniq.sort

      raw_notes = raw_unit_notes(path)
      op["x-clockify-raw-unit-notes"] = raw_notes unless raw_notes.empty?
      notes = Array(op["x-clockify-notes"]) + quirk_notes(path, method)
      notes.concat(findings_for_op.map { |finding| finding["note"] }) if findings_for_op.any?
      notes.concat(other_host_findings.map { |finding| "Wrong-host finding not applied to live status: #{finding["note"]}" }) if other_host_findings.any?
      notes.concat(tools.flat_map { |tool| Array(tool_meta.dig(tool, "notes")) }) if tools.any?
      op["x-clockify-notes"] = notes.uniq.sort unless notes.empty?
      ensure_path_parameters!(op, path, @components["parameters"])
      normalize_op_tags!(op)
      stamp_path_param_patterns!(op)
      ensure_pagination!(op, method, path, @components["parameters"])
      stamp_last_page_header!(op, method, path)
      stamp_sdk_method_name!(op, method, path)
      op["security"] = [{"ApiKeyAuth" => []}, {"AddonTokenAuth" => []}]
      op["servers"] = [{"url" => record[:host]}] if record[:host] != MAIN_SERVER
    end
  end

  def document
    paths = {}
    @operations.keys.sort_by { |method, path| [path, METHOD_ORDER.fetch(method, 99)] }.each do |method, path|
      paths[path] ||= {}
      paths[path][method] = sort_operation(@operations[[method, path]][:op])
    end

    doc = {
      "openapi" => "3.0.3",
      "info" => {
        "title" => "Clockify Unified OpenAPI",
        "version" => "2026-05-12",
        "description" => [
          "Generated by scripts/gen-clockify-openapi from realOPENAPI, clockify-api-probe-lab, AIII/openapi.yaml, GOCLMCP coverage docs, and QA findings.",
          "Do not edit this file by hand; run `make gen-openapi` after source evidence changes.",
          "Operation vendor extensions preserve provenance, host, live status, MCP mapping, risk, raw unit notes, and known upstream quirks."
        ].join("\n")
      },
      "servers" => [
        {"url" => MAIN_SERVER, "description" => "Main Clockify API"},
        {"url" => REPORTS_SERVER, "description" => "Clockify reports and shared-reports API"},
        {"url" => AUDIT_LOG_SERVER, "description" => "Clockify audit-log API"}
      ],
      "security" => [{"ApiKeyAuth" => []}],
      "tags" => tags(paths),
      "paths" => paths,
      "components" => pruned_components(paths),
      "x-clockify-generation" => {
        "generator" => "scripts/gen-clockify-openapi",
        "sourceManifest" => @options[:source_manifest],
        "sourcePrecedence" => [
          "live/probe findings metadata",
          "realOPENAPI operation bodies",
          "probe-lab OpenAPI operation bodies",
          "probe-lab fragments/supplementary OpenAPI operation bodies",
          "AIII official-style OpenAPI export operation bodies for otherwise-missing gaps",
          "pasted DOC Markdown operation inventory",
          "GOCLMCP catalog/coverage annotations"
        ],
        "securityAliasesNormalized" => @aliases.to_a.uniq.sort - ["ApiKeyAuth", "AddonTokenAuth"],
        "securityHeaderAliasesNormalized" => security_header_aliases
      },
      # Sort by both source and reason so multiple quarantines from the
       # same source file (e.g. the 3 phantom /policies/{policyId}/requests
       # routes all hitting time-off-b.yaml) land in a deterministic
       # total order. Without the secondary key the filesystem readdir
       # ordering bleeds through and the openapi-drift gate flips between
       # macOS local + Linux CI (#137 CI repro 2026-05-25).
      "x-clockify-source-quarantine" => @quarantine.sort_by { |entry| [entry["source"], entry["reason"]] }
    }
    doc
  end

  private

  def collect_security_aliases(schemes)
    return unless schemes.is_a?(Hash)

    schemes.each do |scheme, cfg|
      canonical = case scheme.to_s
                  when "AddonKeyAuth", "MarketplaceKeyAuth"
                    @aliases << scheme.to_s
                    "AddonTokenAuth"
                  when "ApiKeyAuth"
                    "ApiKeyAuth"
                  else
                    scheme.to_s
                  end
      header = cfg.is_a?(Hash) ? cfg["name"].to_s : ""
      @security_header_aliases[canonical] << header unless header.empty?
    end
  end

  def security_header_aliases
    @security_header_aliases.keys.sort.each_with_object({}) do |scheme, out|
      out[scheme] = @security_header_aliases[scheme].to_a.sort
    end
  end

  def merge_components(components, domain)
    ref_maps = Hash.new { |h, key| h[key] = {} }
    components.each do |section, values|
      next if section.to_s == "securitySchemes"
      next unless values.is_a?(Hash)

      values.keys.sort.each do |name|
        value = deep_copy(values[name])
        normalize_security!(value, @aliases)
        hash = Digest::SHA256.hexdigest(canonical_json(value))
        existing_by_hash = @component_hashes[section][hash]
        if existing_by_hash
          ref_maps[section][name] = existing_by_hash
          next
        end

        target = name
        if @components[section].key?(target)
          prefix = pascal_domain(domain)
          target = "#{prefix}#{name}"
          suffix = 2
          while @components[section].key?(target)
            target = "#{prefix}#{name}#{suffix}"
            suffix += 1
          end
        end
        @components[section][target] = value
        @component_hashes[section][hash] = target
        ref_maps[section][name] = target
      end
    end
    ref_maps.each do |section, mapping|
      mapping.each_value do |target|
        rewrite_refs!(@components[section][target], ref_maps) if @components[section][target]
      end
    end
    ref_maps
  end

  def merge_parameters(path_params, op_params)
    # NOTE: do NOT use `path_params.concat(op_params)` here — Array#concat
    # mutates the receiver in place. `path_params` is captured once per
    # path-item by the caller and reused across every operation under
    # that path; mutating it leaked the previous method's query params
    # onto the next method, producing duplicate-identifier interfaces
    # in Fern's TS SDK output for POST/PATCH operations that shared a
    # path with a GET (e.g. POST /tags inherited GET /tags's `name`
    # query param even though probe-lab's POST defined no query params).
    # The non-destructive `+` operator avoids the leak.
    merged = []
    seen = Set.new
    (path_params + op_params).each do |param|
      key = if param.is_a?(Hash) && param["$ref"]
              param["$ref"]
            elsif param.is_a?(Hash)
              "#{param["in"]}:#{param["name"]}"
            else
              param.to_s
            end
      next if seen.include?(key)

      seen << key
      merged << param
    end
    merged
  end

  def add_operation(method, path, op, source:, domain:, host:, evidence:, priority:)
    if phantom_path?(method, path)
      @quarantine << {
        "source" => source,
        "reason" => "phantom path quarantined (#{method.upcase} #{path}): see PHANTOM_PATHS in scripts/gen-clockify-openapi"
      }
      return
    end
    op = deep_copy(op)
    source_evidence = Array(op["x-clockify-evidence"])
    source_live_status = op["x-clockify-live-status"].to_s
    op["operationId"] = operation_id(method, path, @used_operation_ids) if op["operationId"].to_s.empty?
    op["tags"] = [tag_for_domain(domain)] if Array(op["tags"]).empty?
    op["x-clockify-source-files"] = [source]
    op["x-clockify-host"] = host
    op["x-clockify-evidence"] = ([evidence] + source_evidence).uniq.sort
    op["x-clockify-live-status"] = source_live_status.empty? ? (evidence == "real-openapi" ? "documented" : evidence) : source_live_status

    key = [method, path]
    existing = @operations[key]
    if existing.nil? || priority > existing[:priority]
      if existing
        op["x-clockify-source-files"] = (Array(op["x-clockify-source-files"]) + Array(existing[:op]["x-clockify-source-files"])).uniq.sort
        op["x-clockify-evidence"] = (Array(op["x-clockify-evidence"]) + Array(existing[:op]["x-clockify-evidence"])).uniq.sort
      end
      @operations[key] = {op: op, priority: priority, host: host}
    else
      existing[:op]["x-clockify-source-files"] = (Array(existing[:op]["x-clockify-source-files"]) + [source]).uniq.sort
      existing[:op]["x-clockify-evidence"] = (Array(existing[:op]["x-clockify-evidence"]) + [evidence]).uniq.sort
      existing[:host] = REPORTS_SERVER if host == REPORTS_SERVER
    end
  end

  def choose_live_status(evidence, findings, tool_statuses = [])
    buckets = findings.map { |finding| finding["bucket"] }
    buckets.concat(tool_statuses)
    return "live-success" if buckets.include?("live-success")
    return "workspace-state-limited" if buckets.include?("workspace-state-limited")
    return "permission-gated" if buckets.include?("permission-gated")
    # A wrong-verb 405 is as unsupported as an absent path for callers; the
    # separate bucket exists so evidence readers can tell the two apart.
    return "unsupported" if buckets.include?("unsupported") || buckets.include?("method-not-allowed")
    return "unit-only" if buckets.include?("unit-only")
    return "probe-documented" if evidence.any? { |entry| entry.to_s.start_with?("probe") }

    "documented"
  end

  def sort_operation(op)
    preferred = %w[tags summary description operationId servers security parameters requestBody responses]
    out = {}
    preferred.each { |key| out[key] = sort_deep(op[key]) if op.key?(key) }
    op.keys.map(&:to_s).sort.each do |key|
      next if out.key?(key)

      out[key] = sort_deep(op[key])
    end
    out
  end

  def tag_for_domain(domain)
    {
      "custom_fields" => "Custom Fields",
      "time_entries" => "Time Entries",
      "time_off" => "Time Off",
      "user_groups" => "User Groups"
    }.fetch(domain, domain.split(/[^a-z0-9]+/).map { |part| part[0].upcase + part[1..] }.join(" "))
  end

  def tags(paths)
    names = paths.values.flat_map do |item|
      item.values.flat_map { |op| Array(op["tags"]) }
    end.uniq.sort
    names.map { |name| {"name" => name} }
  end

  def pruned_components(paths)
    refs = Set.new
    collect_refs(paths, refs)
    changed = true
    while changed
      changed = false
      refs.to_a.each do |ref|
        match = ref.match(%r{\A#/components/([^/]+)/([^/]+)\z})
        next unless match

        value = @components.dig(match[1], match[2])
        next unless value

        before = refs.size
        collect_refs(value, refs)
        changed ||= refs.size > before
      end
    end

    out = {
      "securitySchemes" => {
        "ApiKeyAuth" => {"type" => "apiKey", "in" => "header", "name" => "X-Api-Key"},
        "AddonTokenAuth" => {"type" => "apiKey", "in" => "header", "name" => "X-Addon-Token"}
      }
    }
    @components.keys.sort.each do |section|
      kept = {}
      @components[section].keys.sort.each do |name|
        ref = "#/components/#{section}/#{name}"
        kept[name] = sort_deep(@components[section][name]) if refs.include?(ref)
      end
      out[section] = kept unless kept.empty?
    end
    out
  end

  def collect_refs(value, refs)
    case value
    when Hash
      refs << value["$ref"] if value["$ref"].is_a?(String)
      value.each_value { |child| collect_refs(child, refs) }
    when Array
      value.each { |child| collect_refs(child, refs) }
    end
  end
end

def raw_allowlist_required?(op)
  host = op["x-clockify-host"].to_s
  host.empty? || host == MAIN_SERVER || host == REPORTS_SERVER
end

def document_operation_keys(doc, raw_allowlist_required_only: false)
  keys = []
  (doc["paths"] || {}).each do |path, item|
    item.each do |method, op|
      next unless METHODS.include?(method)
      next if raw_allowlist_required_only && !raw_allowlist_required?(op)

      keys << "#{method.upcase} #{normalize_path(path)}"
    end
  end
  keys.uniq.sort
end

def mcp_probe_allowlist_keys(repo_root)
  path = File.join(repo_root, "internal/tools/tier2_probe_lab_api_gen.go")
  return nil unless File.exist?(path)

  verbs = {
    "Get" => "GET",
    "Post" => "POST",
    "Put" => "PUT",
    "Patch" => "PATCH",
    "Delete" => "DELETE"
  }
  File.read(path).scan(/Method:\s+http\.Method(\w+),\s+Path:\s+"([^"]+)"/m).map do |method, raw_path|
    verb = verbs.fetch(method)
    "#{verb} #{normalize_path(raw_path)}"
  end.uniq.sort
end

def validate_document(doc, repo_root = nil)
  errors = []
  paths = doc["paths"] || {}
  operation_ids = {}
  components = doc["components"] || {}
  refs = []
  collect = lambda do |value|
    case value
    when Hash
      refs << value["$ref"] if value["$ref"].is_a?(String)
      value.each_value { |child| collect.call(child) }
    when Array
      value.each { |child| collect.call(child) }
    end
  end
  collect.call(paths)
  collect.call(components)

  refs.uniq.each { |ref| errors << "unresolved ref #{ref}" if ref.start_with?("#/") && !json_pointer_exists?(doc, ref) }

  CORE_ENTITY_REQUIRED_FIELDS.each do |schema_name, fields|
    schema = components.dig("schemas", schema_name)
    if !schema.is_a?(Hash)
      errors << "schema #{schema_name} missing"
      next
    end
    props = schema["properties"]
    required = schema["required"]
    if !props.is_a?(Hash)
      errors << "schema #{schema_name} missing properties"
      next
    end
    if !required.is_a?(Array) || required.empty?
      errors << "schema #{schema_name} must declare a non-empty required[]"
      next
    end
    fields.each do |field|
      errors << "schema #{schema_name} missing property #{field}" unless props.key?(field)
      errors << "schema #{schema_name} required[] missing #{field}" unless required.include?(field)
    end
  end

  paths.each do |path, item|
    item.each do |method, op|
      next unless METHODS.include?(method)

      id = op["operationId"].to_s
      errors << "#{method.upcase} #{path} missing operationId" if id.empty?
      errors << "duplicate operationId #{id}" if operation_ids.key?(id)
      operation_ids[id] = true
      errors << "#{method.upcase} #{path} missing security" if Array(op["security"]).empty?
      expected_params = path.scan(/\{([^}]+)\}/).flatten
      actual_params = Array(op["parameters"]).map do |param|
        next nil unless param.is_a?(Hash)
        next param["name"] if param["in"] == "path"

        ref = param["$ref"]
        if ref&.start_with?("#/components/parameters/")
          components.dig("parameters", ref.split("/").last, "name")
        end
      end.compact
      expected_params.each do |param|
        errors << "#{method.upcase} #{path} missing path parameter #{param}" unless actual_params.include?(param)
      end
      # Guard the invariant restored by the $ref-query-param fix: no operation may
      # declare the same (name, in) parameter twice (e.g. a manual live override
      # plus a now-surviving $ref of the same query param).
      resolved_param_keys = Array(op["parameters"]).map do |param|
        next nil unless param.is_a?(Hash)

        ref = param["$ref"]
        comp = ref&.start_with?("#/components/parameters/") ? (components.dig("parameters", ref.split("/").last) || {}) : param
        name = comp["name"]
        name.nil? ? nil : [name, comp["in"]]
      end.compact
      param_counts = Hash.new(0)
      resolved_param_keys.each { |key| param_counts[key] += 1 }
      param_counts.each do |(dup_name, dup_in), count|
        errors << "#{method.upcase} #{path} duplicate parameter #{dup_name} (#{dup_in})" if count > 1
      end
      if path.include?("/reports/") || path.include?("shared-reports")
        servers = Array(op["servers"]).map { |server| server["url"] }
        errors << "#{method.upcase} #{path} missing reports server" unless servers.include?(REPORTS_SERVER)
      end
      if op["x-clockify-host"] == AUDIT_LOG_SERVER
        servers = Array(op["servers"]).map { |server| server["url"] }
        errors << "#{method.upcase} #{path} missing audit-log server" unless servers.include?(AUDIT_LOG_SERVER)
      end
    end
  end
  if repo_root
    catalog_path = File.join(repo_root, "docs/tool-catalog.json")
    if File.exist?(catalog_path)
      errors.concat(catalog_contract_errors(JSON.parse(File.read(catalog_path))))
    end

    allowlist = mcp_probe_allowlist_keys(repo_root)
    if allowlist
      missing = document_operation_keys(doc, raw_allowlist_required_only: true) - allowlist
      missing.each do |operation|
        errors << "probe_lab_api allowlist missing OpenAPI operation #{operation}"
      end
    end
  end
  LAST_PAGE_HEADER_OPS.each do |(method, path)|
    unless PAGINATED_LIST_OPS.include?([method, path])
      errors << "LAST_PAGE_HEADER_OPS entry #{method.upcase} #{path} is not in PAGINATED_LIST_OPS; a last-page-header op must also be paginated"
    end
  end
  errors.concat(paginated_ops_live_evidence_errors(doc))
  errors
end

# Verify every entry in PAGINATED_LIST_OPS made it into the emitted
# spec AND is backed by live evidence — the operation must carry an
# `x-clockify-live-status` of `live-success` or `probe-documented`. The
# `documented` bucket is rejected because it means the entry was added
# without a passing live probe or a recorded probe fixture, and a fern
# generator pass that emits page+page-size on an operation we can't
# prove the live API honours is the exact regression that the
# `ensure_pagination!` annotation table is meant to prevent. Treating
# this as a generator-level error (rather than a downstream Go test)
# means a contributor who edits PAGINATED_LIST_OPS gets an immediate
# loud failure at `make gen-openapi` time instead of a silent shipped
# spec.
PAGINATED_LIVE_EVIDENCE_OK = Set.new(%w[live-success probe-documented]).freeze

def paginated_ops_live_evidence_errors(doc)
  errors = []
  paths = doc["paths"] || {}
  PAGINATED_LIST_OPS.each do |(method, path)|
    op = paths.dig(path, method)
    if op.nil?
      errors << "PAGINATED_LIST_OPS entry #{method.upcase} #{path} not emitted; remove the entry or restore the source operation"
      next
    end
    status = op["x-clockify-live-status"].to_s
    unless PAGINATED_LIVE_EVIDENCE_OK.include?(status)
      errors << "PAGINATED_LIST_OPS entry #{method.upcase} #{path} has x-clockify-live-status=#{status.empty? ? "<unset>" : status}; must be one of #{PAGINATED_LIVE_EVIDENCE_OK.to_a.join(", ")} (back the entry with a live probe captured in addons-me/fern/spec/evidence/probes/ before re-adding)"
    end
  end
  errors
end

DAY_ENUM = %w[MONDAY TUESDAY WEDNESDAY THURSDAY FRIDAY SATURDAY SUNDAY].freeze
LIVE_INVOICE_STATUS_ENUM = %w[UNSENT SENT PAID PARTIALLY_PAID VOID OVERDUE].freeze
CHANGE_TRACKER_DOCUMENT_TYPES = %w[
  APPROVAL_REQUESTS
  BALANCE
  CLIENTS
  CUSTOM_FIELDS
  HOLIDAYS
  INVOICES
  PROJECTS
  PTO_POLICY
  SCHEDULED_ASSIGNMENT
  TAGS
  TASKS
  TIME_ENTRY
  TIME_ENTRY_CUSTOM_FIELD_VALUE
  TIME_ENTRY_RATE
  TIME_OFF_REQUEST
  USER
  USER_GROUPS
].freeze

def schema_properties(doc, name)
  schema = doc.dig("components", "schemas", name)
  return nil unless schema.is_a?(Hash)

  schema["properties"] ||= {}
end

def operation_for(doc, path, method)
  doc.dig("paths", path, method)
end

def append_text!(target, key, text)
  existing = target[key].to_s.strip
  return if existing.include?(text)

  target[key] = existing.empty? ? text : "#{existing}\n#{text}"
end

def append_operation_note!(op, note)
  return unless op.is_a?(Hash)

  notes = Array(op["x-clockify-notes"])
  notes << note unless notes.include?(note)
  op["x-clockify-notes"] = notes
end

def ensure_query_parameter!(op, name, schema:, required: false, description: nil, params_components: {})
  op["parameters"] ||= []
  existing = op["parameters"].find do |param|
    next false unless param.is_a?(Hash)

    resolve_param_field(param, params_components, "in") == "query" &&
      resolve_param_field(param, params_components, "name") == name
  end
  if existing
    # The param may have survived as a $ref now that ensure_path_parameters!
    # keeps $ref query params; replace it in place with the live-authoritative
    # inline shape so the required flag / schema win without a duplicate.
    replacement = {"in" => "query", "name" => name, "required" => required, "schema" => schema}
    replacement["description"] = description if description
    op["parameters"][op["parameters"].index(existing)] = replacement
    return
  end

  param = {
    "in" => "query",
    "name" => name,
    "required" => required,
    "schema" => schema
  }
  param["description"] = description if description
  op["parameters"] << param
end

# After apply_live_overrides! rewrites a surviving $ref query param inline (the
# resolve-aware ensure_query_parameter!), the parameter component it referenced can
# be left orphaned — prune_components already ran inside merger.document. Drop any
# components/parameters entry no longer reachable by a $ref so the emitted spec
# carries no dead parameter component. Normalization-only; not merge/dedup logic.
def prune_orphan_parameters!(doc)
  params = doc.dig("components", "parameters")
  return unless params.is_a?(Hash) && !params.empty?

  refs = []
  collect = lambda do |value|
    case value
    when Hash
      refs << value["$ref"] if value["$ref"].is_a?(String)
      value.each_value { |child| collect.call(child) }
    when Array
      value.each { |child| collect.call(child) }
    end
  end
  collect.call(doc["paths"])
  collect.call(doc["components"])
  referenced = Set.new(refs)
  params.keys.each do |name|
    params.delete(name) unless referenced.include?("#/components/parameters/#{name}")
  end
end

def apply_live_overrides!(doc)
  if (schema = doc.dig("components", "schemas", "SummaryGroup")).is_a?(Hash)
    schema["type"] = "string"
    schema["enum"] = (Array(schema["enum"]) | ["TAG"])
    append_text!(schema, "description", "Live reports also accept TAG grouping.")
  end

  # Empty-body 200 is the live no-data representation for these two single
  # totals reads. Keep the response schema useful when data exists, while
  # giving the local TypeScript emitter a precise marker to add `| undefined`
  # to the generated promise type (the runtime already maps an empty JSON body
  # to undefined).
  [
    ["/workspaces/{workspaceId}/scheduling/assignments/projects/totals/{projectId}", "get", "Project totals GET returns 200 with an empty body when the project has no assignments in the requested range."],
    ["/workspaces/{workspaceId}/scheduling/assignments/users/{userId}/totals", "get", "User capacity GET returns 200 with an empty body when the user has no capacity in the requested range."],
  ].each do |path, method, note|
    if (op = operation_for(doc, path, method))
      op["x-clockify-empty-body-is-valid"] = true
      append_operation_note!(op, note)
    end
  end

  if (props = schema_properties(doc, "WeeklyReportResponse"))
    if (totals = props["totals"]).is_a?(Hash) && (items = totals["items"]).is_a?(Hash)
      items["nullable"] = true
      append_text!(totals, "description", "Live empty weeks may contain a literal null item.")
    end
  end

  if (schema = doc.dig("components", "schemas", "AuditLogAuthorsFilter")).is_a?(Hash)
    schema["type"] = "object"
  else
    doc.dig("components", "schemas")["AuditLogAuthorsFilter"] = {
      "type" => "object",
      "description" => "Author filter. Include SYSTEM to retrieve system audit logs.",
      "additionalProperties" => false,
      "properties" => {
        "authorIds" => {
          "type" => "array",
          "uniqueItems" => true,
          "items" => {"type" => "string"},
          "example" => ["SYSTEM"]
        },
        "contains" => {
          "type" => "string",
          "enum" => %w[CONTAINS DOES_NOT_CONTAIN],
          "example" => "DOES_NOT_CONTAIN"
        }
      }
    }
  end
  if (props = schema_properties(doc, "AuditLogRequest"))
    props["authors"] = {"$ref" => "#/components/schemas/AuditLogAuthorsFilter"}
  end

  # The merged entity-change source contains a literal unresolved template and
  # only a partial prose list. Replace all three query schemas with one shared
  # enum so the generated SDK and its JSDoc expose the plural live values.
  doc.dig("components", "schemas")["ChangeTrackerDocumentType"] = {
    "type" => "string",
    "description" => "Entity-change document type accepted by Clockify. Values are plural except TIME_ENTRY and USER.",
    "enum" => CHANGE_TRACKER_DOCUMENT_TYPES
  }

  # All three entity-change reads answer with a BARE ARRAY of entity documents.
  # The source declares `type: string` with `additionalProperties` for created
  # and updated -- a shape that describes nothing, and which the TypeScript
  # emitter faithfully turned into `Promise<string>` -- and an object wrapper
  # (PageableCollectionLogBinDocumentDto) for deleted.
  #
  # Live-probed 2026-08-08: created returned a populated array whose items
  # carry `auditMetadata` and `documentCode` alongside the entity's own fields;
  # updated and deleted returned `[]`. An empty array still refutes the object
  # wrapper. The item shape is proven on created only, so the schema stays open
  # (`additionalProperties: true`) rather than enumerating per-type fields.
  #
  # Note `documentCode`. Clockify's own sample response in the AIII source calls
  # the same field `documentType`; the wire says `documentCode`.
  doc.dig("components", "schemas")["EntityChangeDocument"] = {
    "type" => "object",
    "description" => "One entity-change record. Carries audit timestamps and the document type " \
      "alongside the changed entity's own fields, which vary by `type`.",
    "additionalProperties" => true,
    "properties" => {
      "auditMetadata" => {
        "type" => "object",
        "description" => "Creation and last-update instants for the record.",
        "properties" => {
          "createdAt" => {"type" => "string", "format" => "date-time", "nullable" => true},
          "updatedAt" => {"type" => "string", "format" => "date-time", "nullable" => true}
        }
      },
      "documentCode" => {
        "$ref" => "#/components/schemas/ChangeTrackerDocumentType"
      },
      "id" => {"type" => "string"}
    }
  }

  [
    "/workspaces/{workspaceId}/entities/created",
    "/workspaces/{workspaceId}/entities/updated",
    "/workspaces/{workspaceId}/entities/deleted"
  ].each do |path|
    op = operation_for(doc, path, "get")
    next unless op

    schema = op.dig("responses", "200", "content", "application/json")
    next unless schema.is_a?(Hash)

    schema["schema"] = {
      "type" => "array",
      "items" => {"$ref" => "#/components/schemas/EntityChangeDocument"}
    }
    append_operation_note!(op, "Returns a bare JSON array; live-probed 2026-08-08.")
  end

  # The merged report sources used the generic Openapi* names for the
  # shared-report filter shapes. They are not the same shapes as the direct
  # report filters, so keep the semantics but give them an honest shared
  # namespace before the TypeScript emitter prunes the stale names.
  {
    "OpenapiAttendanceFilter" => "SharedAttendanceFilter",
    "OpenapiDetailedFilter" => "SharedDetailedFilter",
    "OpenapiSummaryFilter" => "SharedSummaryFilter",
    "OpenapiWeeklyFilter" => "SharedWeeklyFilter",
  }.each do |old_name, new_name|
    schemas = doc.dig("components", "schemas")
    next unless schemas.is_a?(Hash) && schemas.key?(old_name)

    schemas[new_name] = schemas.delete(old_name)
  end
  if (props = schema_properties(doc, "SharedReportFilter"))
    {
      "attendanceFilter" => "SharedAttendanceFilter",
      "detailedFilter" => "SharedDetailedFilter",
      "summaryFilter" => "SharedSummaryFilter",
      "weeklyFilter" => "SharedWeeklyFilter",
    }.each do |field, schema_name|
      props[field] = {"$ref" => "#/components/schemas/#{schema_name}"}
    end
  end
  %w[created deleted updated].each do |kind|
    if (op = operation_for(doc, "/workspaces/{workspaceId}/entities/#{kind}", "get"))
      param = Array(op["parameters"]).find do |candidate|
        candidate.is_a?(Hash) && candidate["in"] == "query" && candidate["name"] == "type"
      end
      next unless param

      description = "Entity-change document type. Accepted values: #{CHANGE_TRACKER_DOCUMENT_TYPES.join(", ")}."
      param["description"] = description
      param["schema"] = {
        "type" => "array",
        "description" => description,
        "example" => "TIME_ENTRY",
        "items" => {
          "$ref" => "#/components/schemas/ChangeTrackerDocumentType"
        }
      }
    end
  end

  if (schema = doc.dig("components", "schemas", "DetailedFilter")).is_a?(Hash)
    append_text!(schema, "description", "Pagination belongs in this nested filter as page and pageSize; top-level request page fields are not accepted by /reports/detailed.")
  end

  if (props = schema_properties(doc, "AttendanceReportRequest"))
    strict_date_description = "Strict RFC3339 UTC timestamp with milliseconds, for example 2018-11-01T00:00:00.000Z."
    %w[dateRangeStart dateRangeEnd].each do |field|
      next unless props[field].is_a?(Hash)

      props[field]["description"] = strict_date_description
      props[field]["example"] = field == "dateRangeStart" ? "2018-11-01T00:00:00.000Z" : "2018-11-30T23:59:59.999Z"
    end
  end

  if (op = operation_for(doc, "/workspaces/{workspaceId}/holidays/in-period", "get"))
    Array(op["parameters"]).each do |param|
      next unless param.is_a?(Hash) && param["in"] == "query" && param["name"] == "assigned-to"

      append_text!(param, "description", "This value is a user ID; user-group IDs are not supported and may produce a misleading 403.")
    end
  end

  if (props = schema_properties(doc, "SummaryReportResponse"))
    props.delete("chart")
    props["donutChart"] = {
      "description" => "Live summary reports return donutChart instead of the stale chart key.",
      "items" => {"type" => "object", "additionalProperties" => true},
      "type" => "array"
    }
    props["groupTotals"] = {
      "description" => "Live summary report group total counters.",
      "additionalProperties" => true,
      "properties" => {
        "groupOneTotalCount" => {"type" => "integer"},
        "groupTwoTotalCount" => {"type" => "integer"}
      },
      "type" => "object"
    }
  end

  %w[MemberProfileUpdateRequest MemberProfileDtoV1].each do |schema_name|
    next unless (props = schema_properties(doc, schema_name))

    props["workingDays"] = {
      "description" => "Live Clockify serializes working days as an array of day enum strings; JSON-encoded strings are rejected.",
      "items" => {"type" => "string", "enum" => DAY_ENUM},
      "type" => "array"
    }
  end

  if (props = schema_properties(doc, "UserDtoV1"))
    props["roles"] = {
      "description" => "Included when user responses request role details; shape varies by workspace role surface.",
      "items" => {"type" => "object", "additionalProperties" => true},
      "type" => "array"
    }
  end

  if (props = schema_properties(doc, "WebhookDtoV1"))
    %w[entityType feature payloadType validSourceTypes].each { |field| props.delete(field) }
    append_text!(doc.dig("components", "schemas", "WebhookDtoV1"), "description", "Live webhook records do not return entityType, feature, payloadType, or validSourceTypes.")
  end

  if (schema = doc.dig("components", "schemas", "WebhookRequest"))
    append_text!(schema, "description", "For USER_EMAIL_CHANGED and USER_UPDATED, live Clockify requires triggerSourceType USER_ID and a nonempty triggerSource user id.")
    props = schema["properties"] || {}
    append_text!(props["triggerSourceType"], "description", "USER_EMAIL_CHANGED and USER_UPDATED require USER_ID.") if props["triggerSourceType"].is_a?(Hash)
    append_text!(props["triggerSource"], "description", "USER_EMAIL_CHANGED and USER_UPDATED require at least one user id.") if props["triggerSource"].is_a?(Hash)
  end

  if (schema = doc.dig("components", "schemas", "InvoiceStatus"))
    schema["description"] = "Represents the live status of an invoice. DRAFT is rejected by Clockify; use UNSENT for draft-like invoices."
    schema["enum"] = LIVE_INVOICE_STATUS_ENUM
    schema["type"] = "string"
  end
  if (schema = doc.dig("components", "schemas", "InvoiceStatusRequest"))
    schema["properties"] ||= {}
    schema["properties"]["invoiceStatus"] = {"$ref" => "#/components/schemas/InvoiceStatus"}
    schema["required"] = ["invoiceStatus"]
  end
  if (op = operation_for(doc, "/workspaces/{workspaceId}/invoices/{invoiceId}/export", "get"))
    ensure_query_parameter!(
      op,
      "userLocale",
      required: true,
      schema: {"type" => "string", "default" => "en-US"},
      description: "Required by live Clockify invoice export; the MCP defaults it to en-US.",
      params_components: doc.dig("components", "parameters") || {}
    )
  end

  if (op = operation_for(doc, "/workspaces/{workspaceId}/scheduling/assignments/projects/totals/{projectId}", "get"))
    # Live Clockify REQUIRES start + end on the single-project schedule
    # totals GET: without them it 400s (code 3001, "Required request
    # parameter 'start' ... not present"). The upstream source declares
    # them as $ref query params, but ensure_path_parameters! prunes any
    # non-path $ref param. ensure_path_parameters! now KEEPS those (resolve-aware),
    # so the $ref start/end survive; ensure_query_parameter! is resolve-aware too and
    # rewrites the survivor in place to required:true rather than appending a duplicate
    # (probed 2026-06-21).
    %w[start end].each do |bound|
      ensure_query_parameter!(
        op,
        bound,
        required: true,
        schema: {"type" => "string", "format" => "date-time"},
        description: "Required by live Clockify; the single-project schedule-totals GET 400s without an ISO-8601 #{bound}.",
        params_components: doc.dig("components", "parameters") || {}
      )
    end
  end

  if (schema = doc.dig("components", "schemas", "CreateWorkspaceRequest"))
    schema["required"] = Array(schema["required"]).push("organizationId").uniq
  end

  CORE_ENTITY_REQUIRED_FIELDS.each do |schema_name, fields|
    next unless (schema = doc.dig("components", "schemas", schema_name)).is_a?(Hash)
    next unless (props = schema["properties"]).is_a?(Hash)

    present = fields.select { |field| props.key?(field) }
    schema["required"] = (Array(schema["required"]) + present).uniq
  end

  if (op = operation_for(doc, "/workspaces/{workspaceId}/holidays/in-period", "get"))
    Array(op["parameters"]).each do |param|
      next unless param.is_a?(Hash) && param["in"] == "query" && param["name"] == "assigned-to"

      param["required"] = true
      append_text!(param, "description", "Required by live Clockify for in-period holiday lookup.")
    end
    append_operation_note!(op, "Live Clockify returns 500 for unknown assigned-to user ids instead of a clean 4xx.")
  end

  if (props = schema_properties(doc, "ExpenseCategoryDtoV1"))
    props["status"] = {
      "description" => "Live expense category responses may include status:null.",
      "nullable" => true,
      "type" => "string"
    }
  end
  if (props = schema_properties(doc, "ExpenseDtoV1"))
    append_text!(props["quantity"], "description", "Create/update requests use amount; live expense responses expose the entered amount as quantity and the computed value as total.") if props["quantity"].is_a?(Hash)
  end

  # getWorkspaceExpenses returns HYDRATED rows: nested category/project/task
  # objects plus fileName, and NOT the flat categoryId/projectId/taskId that
  # getExpenseById, createExpense, and updateExpense return. Those two shapes
  # are different and cannot share one schema.
  #
  # The realOPENAPI fragment defines ExpenseHydratedDtoV1 as a bare
  # `allOf: [ExpenseDtoV1]`; because real-openapi outranks aiii-openapi in
  # SOURCE_PRIORITIES, that stub wins the name and the richer AIII definition
  # is renamed away. The stub therefore both drops the nested objects and
  # fileName AND declares three flat ids the list wire never returns.
  #
  # Live probe 2026-07-29 against the sandbox workspace, union of keys across
  # ALL 2845 expense rows (not a single sample):
  #   billable 2845/2845   category 2837/2845   date 2845/2845
  #   fileId 7/2845        fileName 7/2845      id 2845/2845
  #   locked 2845/2845     notes 2823/2845      project 2417/2845
  #   quantity 2845/2845   task 0/2845          total 2845/2845
  #   userId 2845/2845     workspaceId 2845/2845
  # category matched ExpenseCategoryDto's 7 properties exactly and project
  # matched ProjectInfoDto's 5 exactly. `task` was null on every one of the
  # 2845 rows, so its shape is NOT live-proven; TaskInfoDto is carried over
  # from the AIII source rather than guessed here. Nullability is observed
  # (category/project/task/fileId/fileName/notes all go null) but is not
  # declared, because this spec never combines `nullable` with `$ref`.
  if (schema = doc.dig("components", "schemas", "ExpenseHydratedDtoV1"))
    schema.delete("allOf")
    schema["type"] = "object"
    schema["description"] = "Hydrated expense row returned by the workspace expenses list. Carries nested category/project/task objects and fileName instead of the flat categoryId/projectId/taskId that ExpenseDtoV1 exposes."
    schema["properties"] = {
      "billable" => { "default" => false, "description" => "Indicates whether expense is billable or not.", "type" => "boolean" },
      "category" => { "$ref" => "#/components/schemas/ExpenseCategoryDto" },
      "date" => { "description" => "Represents a date in yyyy-MM-dd format.", "example" => "2020-01-01", "type" => "string" },
      "fileId" => { "description" => "Represents file identifier across the system. Usually an empty string when the expense has no receipt (2816 of 2845 sandbox rows); 22 rows carried null instead, so consumers must treat both as \"no receipt\".", "type" => "string" },
      "fileName" => { "description" => "Represents the uploaded receipt file name. Null when the expense has no receipt.", "type" => "string" },
      "id" => { "description" => "Represents expense identifier across the system.", "type" => "string" },
      "locked" => { "description" => "Indicates whether the expense is locked.", "type" => "boolean" },
      "notes" => { "description" => "Represents notes for an expense.", "type" => "string" },
      "project" => { "$ref" => "#/components/schemas/ProjectInfoDto" },
      "quantity" => { "description" => "Represents expense quantity as double data type.", "format" => "double", "type" => "number" },
      "task" => { "$ref" => "#/components/schemas/TaskInfoDto" },
      "total" => { "description" => "Represents expense total as double data type.", "format" => "double", "type" => "number" },
      "userId" => { "description" => "Represents user identifier across the system.", "type" => "string" },
      "workspaceId" => { "description" => "Represents workspace identifier across the system.", "type" => "string" }
    }
  end

  # Live probe 2026-07-29: getBalanceForUser returns negativeBalanceUsed on
  # 50/50 balance rows. BalanceDtoV1 already carries negativeBalanceAmount and
  # negativeBalanceLimit, so without this a caller cannot see whether a
  # negative balance has actually been drawn down.
  if (props = schema_properties(doc, "BalanceDtoV1"))
    props["negativeBalanceUsed"] = {
      "description" => "Represents the amount of the negative balance that has been used.",
      "format" => "double",
      "type" => "number"
    }
  end

  if (props = schema_properties(doc, "ExpenseCreateRequest"))
    append_text!(props["amount"], "description", "Live expense responses expose this value as quantity.") if props["amount"].is_a?(Hash)
    append_text!(props["file"], "description", "Live Clockify accepts create-expense multipart requests without a file.") if props["file"].is_a?(Hash)
    append_text!(props["projectId"], "description", "Live Clockify accepts create-expense multipart requests without a projectId.") if props["projectId"].is_a?(Hash)
    if (schema = doc.dig("components", "schemas", "ExpenseCreateRequest"))
      schema["required"] = Array(schema["required"]) - %w[file projectId]
    end
  end

  # Live Clockify accepts a time-off request status PATCH with only
  # {status} (no note) -> HTTP 200 (probed 2026-06-20/21). The upstream
  # source marks note required; relax it so the generated request type
  # emits note optional, matching the wire. status stays required, so the
  # non-empty required[] invariant still holds.
  if (schema = doc.dig("components", "schemas", "ChangeTimeOffRequestStatusRequest"))
    schema["required"] = Array(schema["required"]) - %w[note]
  end

  [
    ["/workspaces/{workspaceId}/policies/{policyId}", "delete", "Live Clockify requires archiving a time-off policy before deletion."],
    ["/workspaces/{workspaceId}/time-off/policies/{policyId}", "delete", "Live Clockify requires archiving a time-off policy before deletion."],
    ["/workspaces/{workspaceId}/projects/{projectId}/tasks/{taskId}", "delete", "Live Clockify requires marking some tasks DONE before deletion."]
  ].each do |path, method, note|
    append_operation_note!(operation_for(doc, path, method), note)
  end
  %w[
    /workspaces/{workspaceId}/policies/{policyId}
    /workspaces/{workspaceId}/time-off/policies/{policyId}
  ].each do |path|
    append_operation_note!(operation_for(doc, path, "put"), "Policy update payloads should preserve non-null automaticTimeEntryCreation values observed from GET before PUT.")
  end

  if (op = operation_for(doc, "/workspaces/{workspaceId}/webhooks", "get"))
    append_operation_note!(op, "Clockify currently returns 500 for webhooks?type=SYSTEM.")
  end
end

def write_yaml(path, doc)
  FileUtils.mkdir_p(File.dirname(path))
  payload = YAML.dump(JSON.parse(JSON.generate(doc))).sub(/\A---\n/, "")
  File.write(path, payload)
end

if options[:validate_only]
  doc = load_yaml_file(options[:out])
  errors = validate_document(doc, options[:repo_root])
  abort(errors.join("\n")) unless errors.empty?
  puts "validated #{options[:out]}"
  exit 0
end

merger = Merger.new(options)

required_dirs = [options[:real_dir], options[:probe_dir], options[:repo_root]]
missing = required_dirs.reject { |dir| Dir.exist?(dir) }
abort("missing required source directories: #{missing.join(", ")}") unless missing.empty?

options[:source_manifest] = validate_source_manifest!(File.join(options[:repo_root], "docs/openapi/sources"))

yaml_files(options[:real_dir]).each { |path| merger.add_yaml_file(path, "real-openapi") }

probe_root_yaml = File.join(options[:probe_dir], "openapi.yaml")
merger.add_yaml_file(probe_root_yaml, "probe-openapi") if File.exist?(probe_root_yaml)

supplemental = %w[
  Invoiceopenapi.yaml
  USEREXPENCUSTOMFIED.yaml
  inveoice+Balance+Policies+TimeOff.yaml
  openapi_scheduling.yaml
  openapi_timeentry.yaml
  openapi_usergroups_tags.yaml
]
supplemental.each do |name|
  path = File.join(options[:probe_dir], name)
  merger.add_yaml_file(path, "probe-supplement") if File.exist?(path)
end

Dir[File.join(options[:probe_dir], "openapi-fragments", "*.yaml")].sort.each do |path|
  merger.add_yaml_file(path, "probe-fragment")
end
Dir[File.join(options[:probe_dir], "openapi-fragments-v3", "*.yaml")].sort.each do |path|
  merger.add_yaml_file(path, "probe-fragment")
end

merger.add_yaml_file(options[:aiii_openapi], "aiii-openapi") if File.exist?(options[:aiii_openapi])

Dir[File.join(options[:probe_dir], "*DOC.md")].sort.each do |path|
  merger.add_markdown_doc(path)
end

findings = discover_findings(options)
mcp_mapping, tool_risks, tool_meta = discover_mcp_mapping(options)
merger.apply_metadata(findings, mcp_mapping, tool_risks, tool_meta)

doc = merger.document
apply_live_overrides!(doc)
prune_orphan_parameters!(doc)
redact_sensitive_examples!(doc)
errors = validate_document(doc, options[:repo_root])
abort(errors.join("\n")) unless errors.empty?

write_yaml(options[:out], doc)
puts "wrote #{options[:out]}"
puts "operations: #{doc["paths"].sum { |_path, item| item.keys.count { |key| METHODS.include?(key) } }}"
puts "quarantined sources: #{doc["x-clockify-source-quarantine"].size}"
