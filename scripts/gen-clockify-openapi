#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates docs/openapi/clockify-openapi.yaml from the repo-local Clockify API
# evidence bundle. The script is intentionally self-contained because the
# source bundle includes a mix of valid OpenAPI YAML, pasted Markdown API docs,
# live probe findings, and QA reports.

require "date"
require "digest"
require "fileutils"
require "json"
require "optparse"
require "set"
require "yaml"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

METHODS = %w[get post put patch delete options head trace].freeze
METHOD_ORDER = {
  "get" => 0,
  "post" => 1,
  "put" => 2,
  "patch" => 3,
  "delete" => 4,
  "options" => 5,
  "head" => 6,
  "trace" => 7
}.freeze

DEFAULT_REPO_ROOT = File.expand_path("..", __dir__)
DEFAULT_SOURCE_ROOT = File.join(DEFAULT_REPO_ROOT, "docs/openapi/sources")
DEFAULT_REAL_DIR = File.join(DEFAULT_SOURCE_ROOT, "realOPENAPI")
DEFAULT_PROBE_DIR = File.join(DEFAULT_SOURCE_ROOT, "clockify-api-probe-lab")
DEFAULT_AIII_OPENAPI = File.join(DEFAULT_SOURCE_ROOT, "AIII/openapi.yaml")
DEFAULT_OUT = File.join(DEFAULT_REPO_ROOT, "docs/openapi/clockify-openapi.yaml")

MAIN_SERVER = "https://api.clockify.me/api/v1"
REPORTS_SERVER = "https://reports.api.clockify.me/v1"
AUDIT_LOG_SERVER = "https://auditlog-api.api.clockify.me/v1"

SOURCE_PRIORITIES = {
  "real-openapi" => 40,
  "probe-openapi" => 30,
  "probe-supplement" => 25,
  "probe-fragment" => 20,
  "aiii-openapi" => 15,
  "doc-md" => 10
}.freeze
CORE_ENTITY_REQUIRED_FIELDS = {
  "Tag" => %w[id name workspaceId archived],
  "Client" => %w[id name workspaceId archived],
  "Project" => %w[id name workspaceId billable color archived public template],
  "Task" => %w[id name projectId status billable],
  "UserDtoV1" => %w[id email name status],
  "TimeEntry" => %w[id description userId billable workspaceId timeInterval type isLocked]
}.freeze
SENSITIVE_EXAMPLE_KEY_RE = /\A(?:api[_-]?key|auth[_-]?token|token|secret)\z/i
EMAIL_EXAMPLE_RE = /\b[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}\b/i

options = {
  real_dir: ENV.fetch("CLOCKIFY_OPENAPI_REAL_DIR", DEFAULT_REAL_DIR),
  probe_dir: ENV.fetch("CLOCKIFY_OPENAPI_PROBE_DIR", DEFAULT_PROBE_DIR),
  findings_dir: ENV["CLOCKIFY_OPENAPI_FINDINGS_DIR"],
  aiii_openapi: ENV.fetch("CLOCKIFY_OPENAPI_AIII_FILE", DEFAULT_AIII_OPENAPI),
  repo_root: ENV.fetch("CLOCKIFY_OPENAPI_REPO_ROOT", DEFAULT_REPO_ROOT),
  out: DEFAULT_OUT,
  validate_only: false
}

OptionParser.new do |opts|
  opts.banner = "Usage: scripts/gen-clockify-openapi [options]"
  opts.on("-out PATH", "--out PATH", "Output YAML path") { |v| options[:out] = v }
  opts.on("--real-dir PATH", "realOPENAPI source directory") { |v| options[:real_dir] = v }
  opts.on("--probe-dir PATH", "clockify-api-probe-lab directory") { |v| options[:probe_dir] = v }
  opts.on("--findings-dir PATH", "QA findings directory") { |v| options[:findings_dir] = v }
  opts.on("--aiii-openapi PATH", "additional official-style OpenAPI export") { |v| options[:aiii_openapi] = v }
  opts.on("--repo-root PATH", "GOCLMCP repo root") { |v| options[:repo_root] = v }
  opts.on("--validate-only", "Validate an existing generated YAML") { options[:validate_only] = true }
end.parse!

def deep_copy(value)
  JSON.parse(JSON.generate(value))
end

def canonical_json(value)
  JSON.generate(sort_deep(value))
end

def sort_deep(value)
  case value
  when Hash
    value.keys.map(&:to_s).sort.each_with_object({}) do |key, out|
      out[key] = sort_deep(value[key])
    end
  when Array
    value.map { |item| sort_deep(item) }
  else
    value
  end
end

def redact_sensitive_examples!(value)
  case value
  when Hash
    value.each do |key, child|
      if child.is_a?(String) && key.to_s.match?(SENSITIVE_EXAMPLE_KEY_RE)
        value[key] = "<redacted>"
      elsif child.is_a?(String)
        value[key] = child.gsub(EMAIL_EXAMPLE_RE, "<EMAIL>")
      else
        redact_sensitive_examples!(child)
      end
    end
  when Array
    value.each_with_index do |child, index|
      if child.is_a?(String) && !value.frozen?
        value[index] = child.gsub(EMAIL_EXAMPLE_RE, "<EMAIL>")
      else
        redact_sensitive_examples!(child)
      end
    end
  end
end

def yaml_files(dir)
  return [] unless Dir.exist?(dir)

  Dir[File.join(dir, "*")].select { |path| path.match?(/\.(ya?ml)\z/i) }.sort
end

def load_yaml_file(path)
  YAML.load_file(path, aliases: true, permitted_classes: [Date, Time])
rescue ArgumentError
  YAML.load_file(path)
end

def source_manifest(root)
  path = File.join(root, "manifest.json")
  return nil unless File.exist?(path)

  manifest = JSON.parse(File.read(path))
  digest = Digest::SHA256.file(path).hexdigest
  [path, manifest, digest]
end

def validate_source_manifest!(root)
  payload = source_manifest(root)
  return nil unless payload

  path, manifest, digest = payload
  errors = []
  Array(manifest["files"]).each do |entry|
    rel = entry["path"].to_s
    if rel.empty? || rel.start_with?("/") || rel.split("/").include?("..")
      errors << "invalid source manifest path #{rel.inspect}"
      next
    end
    file = File.join(root, rel)
    unless File.file?(file)
      errors << "source manifest missing #{rel}"
      next
    end
    size = File.size(file)
    sha = Digest::SHA256.file(file).hexdigest
    errors << "source manifest size mismatch #{rel}" if entry["bytes"].to_i != size
    errors << "source manifest sha256 mismatch #{rel}" if entry["sha256"].to_s != sha
  end

  # Completeness (reverse) check: every consumed openapi fragment on disk must be
  # pinned in the manifest. The forward loop above only verifies LISTED files; it
  # never asserts that every consumed input is listed, so a new/edited fragment
  # could otherwise slip in unhashed (e.g. audit-log.yaml did). These globs mirror
  # the generator's own probe-fragment globs below.
  pinned = Array(manifest["files"]).map { |entry| entry["path"].to_s }
  ["clockify-api-probe-lab/openapi-fragments", "clockify-api-probe-lab/openapi-fragments-v3"].each do |dir|
    Dir[File.join(root, dir, "*.yaml")].sort.each do |abs|
      rel = abs.sub(%r{\A#{Regexp.escape(root)}/?}, "")
      errors << "source consumed but not pinned in manifest: #{rel}" unless pinned.include?(rel)
    end
  end
  abort(errors.join("\n")) unless errors.empty?

  {
    "path" => path.sub(%r{\A#{Regexp.escape(root)}/?}, ""),
    "sha256" => digest,
    "files" => Array(manifest["files"]).size
  }
end

def source_label(path, options)
  expanded = File.expand_path(path)
  roots = {
    "realOPENAPI" => File.expand_path(options[:real_dir]),
    "clockify-api-probe-lab" => File.expand_path(options[:probe_dir]),
    "AIII" => File.dirname(File.expand_path(options[:aiii_openapi])),
    "GOCLMCP" => File.expand_path(options[:repo_root])
  }
  roots["qa-findings"] = File.expand_path(options[:findings_dir]) if options[:findings_dir].to_s != ""
  root_name, root_path = roots.find { |_name, root| expanded.start_with?(root + File::SEPARATOR) || expanded == root }
  return expanded unless root_name

  rel = expanded.sub(root_path, "").sub(%r{\A/}, "")
  rel.empty? ? root_name : File.join(root_name, rel)
end

def domain_from_path(path)
  base = File.basename(path).downcase
  return "reports" if base.include?("attendance") || base.include?("report")
  return "approval" if base.include?("approval")
  return "balance" if base.include?("balance")
  return "custom_fields" if base.include?("cf") || base.include?("custom")
  return "expenses" if base.include?("expense")
  return "holidays" if base.include?("holiday")
  return "invoices" if base.include?("invoice") || base.include?("inveoice")
  return "policies" if base.include?("polic")
  return "projects" if base.include?("project")
  return "scheduling" if base.include?("schedul")
  return "tasks" if base.include?("task")
  return "time_entries" if base.include?("timeentr")
  return "time_off" if base.include?("timeoff") || base.include?("time-off")
  return "user_groups" if base.include?("group")
  return "users" if base.include?("user")
  return "webhooks" if base.include?("webhook")
  return "workspaces" if base.include?("workspace")
  return "clients" if base.include?("client")
  return "tags" if base.include?("tag")

  File.basename(path, File.extname(path)).downcase.gsub(/[^a-z0-9]+/, "_")
end

def pascal_domain(domain)
  domain.split(/[^a-z0-9]+/).reject(&:empty?).map { |part| part[0].upcase + part[1..] }.join
end

def normalize_path(path)
  normalized = path.to_s.strip
  normalized = normalized.sub(%r{\Ahttps://auditlog-api\.api\.clockify\.me/api/v1}, "")
  normalized = normalized.sub(%r{\Ahttps://auditlog-api\.api\.clockify\.me/v1}, "")
  normalized = normalized.sub(%r{\Ahttps://api\.clockify\.me/api/v1}, "")
  normalized = normalized.sub(%r{\Ahttps://reports\.api\.clockify\.me/v1}, "")
  normalized = normalized.sub(%r{\Ahttps://api\.clockify\.me/api}, "")
  normalized = normalized.sub(%r{\Ahttps://reports\.api\.clockify\.me}, "")
  normalized = normalized.sub(%r{\A/api/v1}, "")
  normalized = normalized.sub(%r{\A/v1}, "")
  normalized = "/" + normalized unless normalized.start_with?("/")
  canonicalize_path_params(normalized.gsub(%r{/+}, "/"))
end

def canonicalize_path_params(path)
  segments = path.split("/")
  segments.each_with_index do |segment, i|
    next unless segment.match?(/\A\{[^}]+\}\z/)

    raw_name = segment[1..-2]
    previous = segments[i - 1].to_s
    canonical = case raw_name
                when "ws", "wsId", "workspace", "workspace_id", "workspaceId"
                  "workspaceId"
                when "uid", "user", "user_id", "userId"
                  "userId"
                else
                  canonical_param_for_segment(previous, raw_name)
                end
    segments[i] = "{#{canonical}}"
  end
  out = segments.join("/")
  out.empty? ? "/" : out
end

def canonical_param_for_segment(segment, fallback)
  {
    "addons" => "addonId",
    "approval-requests" => "approvalRequestId",
    "assignments" => "assignmentId",
    "categories" => "categoryId",
    "clients" => "clientId",
    "custom-fields" => "customFieldId",
    "expenses" => "expenseId",
    "holidays" => "holidayId",
    "invoices" => "invoiceId",
    "items" => "order",
    "payments" => "paymentId",
    "policies" => "policyId",
    "projects" => "projectId",
    "requests" => "requestId",
    "shared-reports" => "sharedReportId",
    "tags" => "tagId",
    "tasks" => "taskId",
    "time-entries" => "timeEntryId",
    "user" => "userId",
    "user-groups" => "groupId",
    "users" => "userId",
    "webhooks" => "webhookId"
  }.fetch(segment, fallback)
end

def host_for(path, op = nil, source_servers = [])
  text = [path, op&.fetch("description", nil), op&.fetch("summary", nil)].compact.join(" ").downcase
  operation_servers = Array(op && op["servers"]).map { |server| server["url"].to_s }
  return AUDIT_LOG_SERVER if operation_servers.any? { |url| url.include?("auditlog-api.api.clockify.me") }
  return REPORTS_SERVER if operation_servers.any? { |url| url.include?("reports.api.clockify.me") } &&
                           operation_servers.none? { |url| url.include?("api.clockify.me/api") }
  return AUDIT_LOG_SERVER if source_servers.any? { |url| url.include?("auditlog-api.api.clockify.me") }
  return REPORTS_SERVER if source_servers.any? { |url| url.include?("reports.api.clockify.me") } &&
                           source_servers.none? { |url| url.include?("api.clockify.me/api") }
  return AUDIT_LOG_SERVER if text.include?("auditlog-api.api.clockify.me") || text.include?("/audit-log")
  return REPORTS_SERVER if text.include?("/reports/") || text.include?("shared-reports")

  MAIN_SERVER
end

def normalize_security!(value, aliases)
  case value
  when Hash
    value.keys.each do |key|
      new_key = case key.to_s
                when "AddonKeyAuth", "MarketplaceKeyAuth"
                  aliases << key.to_s
                  "AddonTokenAuth"
                when "ApiKeyAuth"
                  "ApiKeyAuth"
                else
                  key
                end
      child = value.delete(key)
      value[new_key] = child
      normalize_security!(child, aliases)
    end
  when Array
    value.each { |item| normalize_security!(item, aliases) }
  end
end

def canonical_security_scheme(name)
  case name.to_s
  when "AddonKeyAuth", "MarketplaceKeyAuth", "AddonTokenAuth"
    "AddonTokenAuth"
  when "ApiKeyAuth"
    "ApiKeyAuth"
  else
    name.to_s
  end
end

def operation_security_aliases(op, schemes)
  aliases = Hash.new { |h, key| h[key] = {"schemes" => Set.new, "headers" => Set.new} }
  Array(op["security"]).each do |requirement|
    next unless requirement.is_a?(Hash)

    requirement.keys.each do |scheme|
      canonical = canonical_security_scheme(scheme)
      aliases[canonical]["schemes"] << scheme.to_s
      header = schemes.dig(scheme, "name").to_s if schemes.is_a?(Hash)
      aliases[canonical]["headers"] << header unless header.to_s.empty?
    end
  end
  aliases.keys.sort.each_with_object({}) do |scheme, out|
    out[scheme] = {
      "schemes" => aliases[scheme]["schemes"].to_a.sort,
      "headers" => aliases[scheme]["headers"].to_a.sort
    }
  end
end

def rewrite_refs!(value, ref_maps)
  case value
  when Hash
    if value["$ref"].is_a?(String)
      value["$ref"] = rewrite_ref(value["$ref"], ref_maps)
    end
    value.each_value { |child| rewrite_refs!(child, ref_maps) }
  when Array
    value.each { |child| rewrite_refs!(child, ref_maps) }
  end
end

def rewrite_ref(ref, ref_maps)
  match = ref.match(%r{\A#/components/([^/]+)/([^/]+)\z})
  return ref unless match

  section = match[1]
  name = match[2]
  mapped = ref_maps.dig(section, name)
  mapped ? "#/components/#{section}/#{mapped}" : ref
end

def operation_id(method, path, used)
  raw = "#{method}_#{path}"
        .gsub(/[{}]/, "")
        .gsub(/[^a-zA-Z0-9]+/, "_")
        .gsub(/\A_+|_+\z/, "")
  parts = raw.split("_").reject(&:empty?)
  id = parts.first.to_s.downcase + parts.drop(1).map { |part| part[0].upcase + part[1..] }.join
  id = "#{method}Operation" if id.empty?
  unique = id
  suffix = 2
  while used.include?(unique)
    unique = "#{id}#{suffix}"
    suffix += 1
  end
  used << unique
  unique
end

def method_path_from_doc(lines)
  operations = []
  pending_method = nil
  lines.each do |line|
    stripped = line.strip
    if stripped.match?(/\A(GET|POST|PUT|PATCH|DELETE)\z/i)
      pending_method = stripped.downcase
      next
    end
    inline = stripped.match(/\A(GET|POST|PUT|PATCH|DELETE)\s+(\/(?:api\/)?v1\/\S+)/i)
    if inline
      operations << [inline[1].downcase, normalize_path(inline[2])]
      pending_method = nil
      next
    end
    next unless pending_method && stripped.match?(%r{\A/(?:api/)?v1/})

    path = stripped.split(/\s+/).first
    operations << [pending_method, normalize_path(path)]
    pending_method = nil
  end
  operations.uniq
end

def extract_status(raw)
  token = raw.to_s[/\b([1-5][0-9][0-9])\b/, 1]
  token&.to_i
end

def pending_live_finding_row?(text)
  text.to_s.match?(/\bTODO-live\b/i)
end

def status_bucket(status, text)
  lowered = text.to_s.downcase
  return "live-success" if status && status >= 200 && status < 300
  # 405 means the path EXISTS and the verb does not. Clockify returns
  # code:3000 for this as well as for an absent path, so bucket 405
  # separately before the absent-path test below; otherwise a live route
  # documented under the wrong verb reads as a phantom and invites a
  # wrong PHANTOM_PATHS entry. The distinguishing wire signal is the
  # `allow` response header, which lists the verbs the path does serve.
  return "method-not-allowed" if status == 405
  # 4xx with the "No static resource" upstream message means the path
  # itself does not exist. Match the MESSAGE, not the bare code:3000,
  # which Clockify reuses for wrong-verb responses. Treat as fully
  # unsupported / phantom so callers can decide to quarantine the path.
  # The /cap/ keyword used to match /scheduling/capacity by accident —
  # narrow it to whole words.
  return "unsupported" if status && [400, 404, 409, 415, 422].include?(status) &&
                          lowered.match?(/no static resource/)
  return "workspace-state-limited" if lowered.match?(/archive|active|workspace-state|in-use|\bcap-skipped\b|\bcap\s|\blimit\b/)
  return "permission-gated" if lowered.match?(/permission|plan|membership|owner|forbidden|not allowed|requires/)
  return "unsupported" if status && [400, 404, 405, 409, 415, 422].include?(status)
  return "documented" unless status

  "live-validated-error"
end

# Phantom-path quarantine. Any (method, path) listed here is dropped
# from the merged contract because some upstream evidence source guesses
# at a route that Clockify does not actually serve (the canonical signal
# is a 404 body containing "No static resource" / Clockify error 3000).
# Keep this list short and justify each entry.
PHANTOM_PATHS = [
  # /workspaces/{workspaceId}/scheduling/capacity — present in
  # clockify-api-probe-lab/openapi.yaml as a hand-written guess, but the
  # adjacent probe fixture proves Clockify responds with
  # {"message":"No static resource v1/workspaces/{ws}/scheduling/capacity.","code":3000}.
  # The realOPENAPI/SCHEDULINGOPENAPI.YAML does not list it.
  ["get", "/workspaces/{workspaceId}/scheduling/capacity"],
  # /workspaces/{workspaceId}/balance (GET + PATCH) — present in
  # clockify-api-probe-lab/openapi.yaml as a hand-written guess
  # (lines 2306-2336) at a route that does not exist on the live API.
  # Re-probe 2026-05-24 against sandbox 65b382b606de527a7ee2b60e with
  # `policyId=<real>` returned HTTP 404 + Clockify error code 3000:
  # `{"message":"No static resource v1/workspaces/{wsId}/balance.","code":3000}`.
  # The published API surfaces balance through the granular routes
  # /workspaces/{wsId}/time-off/balance/policy/{policyId} and
  # .../user/{userId} (both modelled in realOPENAPI/BALANCEOPEANI.yaml
  # and already stamped in PAGINATED_LIST_OPS). Probe fixture:
  # addons-me/fern/spec/evidence/probes/20260524-deferred-balance-policy.{json,hdr}.
  # Ledger: spec/evidence/discrepancies.md →
  # deferred-list-endpoints.not-paginated-or-not-live, open question 1.
  ["get", "/workspaces/{workspaceId}/balance"],
  ["patch", "/workspaces/{workspaceId}/balance"],
  # /workspaces/{workspaceId}/policies/{policyId}/requests/* trio
  # (POST + DELETE + PATCH) — three time-off-request action paths
  # that appear in the canonical OpenAPI under the `Time Off` tag
  # but do NOT exist on the live API. Live re-probe 2026-05-25
  # against sandbox 65b382b606de527a7ee2b60e with policyId=
  # 696fd7f25dd6c5510bafa772 returned HTTP 404 + Clockify error
  # code 3000 on all three method variants:
  # `{"message":"No static resource v1/workspaces/{ws}/policies/
  # {pid}/requests[/{rid}].","code":3000}`. The live time-off
  # request surface is at /workspaces/{ws}/time-off/policies/
  # {pid}/requests/* (the scoped path that includes `time-off/`)
  # — already stamped as `submit` / `withdraw` and friends. Probe
  # fixtures: addons-me/fern/spec/evidence/probes/20260525-
  # timeoff-legacy-{post,delete,patch}.{json,hdr}. Ledger entry:
  # spec/evidence/discrepancies.md → `timeoff.legacy-policies-
  # requests.phantom-path-quarantined`.
  ["post",   "/workspaces/{workspaceId}/policies/{policyId}/requests"],
  ["delete", "/workspaces/{workspaceId}/policies/{policyId}/requests/{requestId}"],
  ["patch",  "/workspaces/{workspaceId}/policies/{policyId}/requests/{requestId}"],
  # Three additional phantoms surfaced during the G.1 domain
  # edge-case sweep (2026-05-25 re-probe, sandbox 65b382b606de527a7ee2b60e):
  #
  # - POST /workspaces/{wsId}/time-off/requests/users/{userId} ->
  #   HTTP 404 + code 3000 "No static resource". Looked like an
  #   admin "create TOR for a specific user via the workspace-level
  #   path" but doesn't exist; the live equivalent is the policy-
  #   scoped `submitForUser` at /time-off/policies/{pid}/users/
  #   {uid}/requests.
  # - GET /workspaces/{wsId}/time-off/requests -> HTTP 405 + code
  #   3000 "Request method 'GET' is not supported". The path
  #   exists for POST (that's `list`, the documented POST-as-list
  #   quirk) but GET is not allowed. The canonical's own
  #   x-clockify-notes block on this op already documents the 405
  #   from a prior probe-supplement -- the quarantine just stops
  #   us from generating an SDK method that immediately 405s.
  # - GET /workspaces/{wsId}/users/{userId}/time-off/balances ->
  #   HTTP 404 + code 3000 "No static resource". Looked like a
  #   per-user time-off balances list across all policies, but
  #   doesn't exist; the live per-user balance read is the
  #   singular /time-off/balance/user/{userId} (already stamped
  #   as balances.getForUser).
  #
  # Probe fixtures (gitignored):
  # - addons-me/fern/spec/evidence/probes/20260525-edge-post-tor-users-userid.{json,hdr}
  # - addons-me/fern/spec/evidence/probes/20260525-edge-get-tor.{json,hdr}
  # - addons-me/fern/spec/evidence/probes/20260525-edge-get-user-balances.{json,hdr}
  # Ledger update lives under
  # discrepancies.md > timeoff.legacy-policies-requests.phantom-path-quarantined.
  ["post", "/workspaces/{workspaceId}/time-off/requests/users/{userId}"],
  ["get",  "/workspaces/{workspaceId}/time-off/requests"],
  ["get",  "/workspaces/{workspaceId}/users/{userId}/time-off/balances"],
  # PATCH /workspaces/{wsId}/user/{userId}/time-entries/stop — the legacy
  # "stop running timer via dedicated /stop route". The live stop flow is a
  # PATCH on /user/{userId}/time-entries with {end} (timeEntries.updateForUser);
  # the /stop route is dead generated surface (F1 2B cleanup). Ledger:
  # clockify-ts-sdk spec/evidence/discrepancies.md.
  ["patch", "/workspaces/{workspaceId}/user/{userId}/time-entries/stop"],
  # ---- 2026-06-23 live API surface audit (clockify-ts-sdk
  # spec/evidence/discrepancies.md > surface.audit.2026-06-23) ----
  # 17 synthetic / wrong-path operations that appear in the merged set but
  # do NOT exist on the live API. Maintainer-confirmed (2026-06-23) these are
  # wrong paths, not plan-gating; re-confirmed against the fresh official pull
  # (168 ops, 7 deprecated) which carries none of them. Each was probed live
  # (sandbox 65b382b606de527a7ee2b60e): 404 "No static resource" / code 3000
  # or 405 "method not supported". The correct-path variant (where one exists)
  # stays in the surface and is noted inline.
  #
  # (a) Synthetic 405 ops with no source op-body (operationId synthesized in
  #     merge from method+path) — no live route:
  ["get", "/workspaces/{workspaceId}/user-groups/{groupId}"],
  ["get", "/workspaces/{workspaceId}/user-groups/{groupId}/users"],
  ["put", "/workspaces/{workspaceId}"],
  # member-profile: the live write op is the PATCH updateMemberProfile (kept,
  # live-success). Only the synthetic PUT is quarantined.
  ["put", "/workspaces/{workspaceId}/member-profile/{userId}"],
  # (b) Bare /policies x6 — pure duplicates of the correct /time-off/policies
  #     family (getTimeOffPolicies/createTimeOffPolicy/getTimeOffPolicy/
  #     updateTimeOffPolicy/changeTimeOffPolicyStatus/deleteTimeOffPolicy, all
  #     kept). The bare /archive invents a sub-path; archive == the status PATCH.
  ["get",    "/workspaces/{workspaceId}/policies"],
  ["post",   "/workspaces/{workspaceId}/policies"],
  ["get",    "/workspaces/{workspaceId}/policies/{policyId}"],
  ["put",    "/workspaces/{workspaceId}/policies/{policyId}"],
  ["delete", "/workspaces/{workspaceId}/policies/{policyId}"],
  ["patch",  "/workspaces/{workspaceId}/policies/{policyId}/archive"],
  # (c) Synthetic scheduling/assignments writes (5) — the 5 totals READS on
  #     /scheduling/assignments/all|projects/totals|user-filter/totals|
  #     users/{userId}/totals stay (live-success) and the valid recurring
  #     PATCH/DELETE stay; only these 5 absent-from-official methods go:
  ["post",   "/workspaces/{workspaceId}/scheduling/assignments"],
  ["put",    "/workspaces/{workspaceId}/scheduling/assignments/recurring/{assignmentId}"],
  ["post",   "/workspaces/{workspaceId}/scheduling/assignments/users/totals"],
  ["put",    "/workspaces/{workspaceId}/scheduling/assignments/{assignmentId}"],
  ["delete", "/workspaces/{workspaceId}/scheduling/assignments/{assignmentId}"],
  # (d) Project-LEVEL rate PUTs (2) — only the project-USER rate paths
  #     (.../projects/{projectId}/users/{userId}/{hourly,cost}-rate) exist and
  #     are live-success; the project-level (no userId) variants 404.
  ["put", "/workspaces/{workspaceId}/projects/{projectId}/hourly-rate"],
  ["put", "/workspaces/{workspaceId}/projects/{projectId}/cost-rate"],
  # (f) Proven absent by the 2026-07-28 fake-id existence sweep against the
  #     sacrificial sandbox. Each returned 404 with
  #     {"message":"No static resource ...","code":3000}, the canonical
  #     path-not-served signal. Evidence: clockify-ts-sdk
  #     spec/evidence/discrepancies.md, entries
  #     `archive-subpaths.projects-clients.phantom`,
  #     `time-off.requests.by-id.family-phantom`,
  #     `webhooks.generateNewToken.phantom`.
  #
  #     The /archive sub-paths: a prior note recorded only
  #     POST /projects/{id}/archive as dead, which did not transfer to these
  #     PUT forms. Probing shows the PUT shape is absent too. Archiving is done
  #     through the update body envelope, which is unaffected.
  ["put", "/workspaces/{workspaceId}/projects/{projectId}/archive"],
  ["put", "/workspaces/{workspaceId}/clients/{clientId}/archive"],
  #     The whole by-id branch under /time-off/requests/ is unserved. Note this
  #     is NOT changeTimeOffRequestStatus, whose policy-scoped path
  #     (/time-off/policies/{policyId}/requests/{requestId}) does exist and
  #     returns 400 on a fake id.
  ["get",    "/workspaces/{workspaceId}/time-off/requests/{requestId}"],
  ["delete", "/workspaces/{workspaceId}/time-off/requests/{requestId}"],
  ["patch",  "/workspaces/{workspaceId}/time-off/requests/{requestId}/status"],
  #     Token rotation has exactly one live path: PATCH .../webhooks/{id}/token
  #     (400 on a fake id). The generateNewToken sub-path is absent.
  ["patch", "/workspaces/{workspaceId}/webhooks/{webhookId}/generateNewToken"],
  # ---- 2026-08-04/05 clockify-ts-sdk Slice-1 live adjudication (sandbox
  #      65b382b606de527a7ee2b60e; see clockify-ts-sdk
  #      spec/evidence/discrepancies.md) ----
  #
  # PATCH /workspaces/{workspaceId}/time-entries/invoiced/bulk
  # (markInvoicedBulk) — re-probed every method (GET/POST/PUT/PATCH/DELETE/
  # OPTIONS) against a real workspace; all six returned 404
  # {"message":"No static resource ...","code":3000}. Not a 405 with an
  # Allow header pointing at a different verb — the path itself is unserved
  # at every verb. The generated SDK exposed markInvoicedBulk but no CLI/MCP
  # tool referenced it (confirmed before quarantine).
  ["patch", "/workspaces/{workspaceId}/time-entries/invoiced/bulk"],
  # GET /workspaces/{workspaceId}/webhooks/{webhookId}/logs — a wrong-verb
  # duplicate. clockify-api-probe-lab/openapi-fragments/webhooks-a.yaml
  # hand-wrote this path as `get:`, but the higher-priority
  # realOPENAPI/WEBHOOKSOPENAPI.YAML already defines the SAME path as
  # `post:` (operationId getWebhookLogs, kept as `searchLogs`,
  # live-success). Because the merge keys on [method, path], the two
  # verbs never collided as one operation to resolve by source priority —
  # both survived as distinct operations. Live re-probe: GET/PUT/PATCH/
  # DELETE all return 405 with `Allow: POST`; POST returns a real 200
  # (structured log array) with a real webhook id, or a structured 400
  # ("Webhook doesn't belong to Workspace") with a fake one. Only the
  # POST operation is real; the GET is a phantom sibling that never had a
  # live route.
  ["get", "/workspaces/{workspaceId}/webhooks/{webhookId}/logs"]
].freeze

def phantom_path?(method, path)
  PHANTOM_PATHS.include?([method.downcase, path])
end

def host_from_source(value)
  text = value.to_s.downcase
  return AUDIT_LOG_SERVER if text.include?("auditlog-api.api.clockify.me")
  return REPORTS_SERVER if text.include?("reports.api.clockify.me")
  return MAIN_SERVER if text.include?("api.clockify.me")

  nil
end

def server_from_finding(host_value, path_value)
  host_text = host_value.to_s.downcase
  path_text = path_value.to_s.downcase
  text = "#{host_text} #{path_text}"
  return "https://auditlog-api.api.clockify.me/api/v1" if text.include?("auditlog-api.api.clockify.me") && path_text.match?(%r{(^|/)api/v1/})
  return AUDIT_LOG_SERVER if text.include?("auditlog-api.api.clockify.me")
  reports = text.include?("reports.api.clockify.me")
  main = text.include?("api.clockify.me") && !reports
  return "https://reports.api.clockify.me/api/v1" if reports && path_text.match?(%r{(^|/)api/v1/})
  return REPORTS_SERVER if reports
  return "https://api.clockify.me/v1" if main && path_text.match?(%r{(^|/)v1/}) && !path_text.match?(%r{(^|/)api/v1/})
  return MAIN_SERVER if main

  nil
end

def discover_findings(options)
  records = Hash.new { |h, key| h[key] = [] }
  files = []
  probe_findings = File.join(options[:probe_dir], "findings")
  files.concat(Dir[File.join(probe_findings, "*.md")]) if Dir.exist?(probe_findings)
  if options[:findings_dir].to_s != "" && Dir.exist?(options[:findings_dir])
    files.concat(Dir[File.join(options[:findings_dir], "agent-*.md")])
  end
  files.sort.each do |file|
    label = source_label(file, options)
    File.readlines(file, chomp: true).each do |line|
      next if pending_live_finding_row?(line)

      cells = line.split("|").map(&:strip)
      next unless cells.size >= 5

      method = nil
      path = nil
      status = nil
      host = nil
      if METHODS.include?(cells[1].to_s.downcase) && cells[3].to_s.include?("/")
        method = cells[1].downcase
        path = normalize_path(cells[3])
        host = server_from_finding(cells[2], cells[3]) || host_from_source(cells[2]) || host_from_source(cells[3])
        status = extract_status(cells[4])
      elsif METHODS.include?(cells[3].to_s.downcase) && cells[2].to_s.include?("/")
        method = cells[3].downcase
        path = normalize_path(cells[2])
        host = server_from_finding(cells[1], cells[2]) || host_from_source(cells[1]) || host_from_source(cells[2])
        status = extract_status(cells[4])
      elsif cells[1].to_s.include?("/") && METHODS.include?(cells[2].to_s.downcase)
        method = cells[2].downcase
        path = normalize_path(cells[1])
        host = server_from_finding(cells[1], cells[1]) || host_from_source(cells[1])
        status = extract_status(cells[3])
      end
      next unless method && path

      text = line
      records[[method, path, host]] << {
        "source" => label,
        "host" => host,
        "status" => status,
        "bucket" => status_bucket(status, text),
        "note" => text.gsub(/\s+/, " ")[0, 240]
      }
    end
  end
  records
end

def discover_mcp_mapping(options)
  path = File.join(options[:repo_root], "docs/api-coverage.md")

  mapping = Hash.new { |h, key| h[key] = Set.new }
  tool_meta = Hash.new do |h, key|
    h[key] = {
      "evidence" => Set.new,
      "statuses" => Set.new,
      "notes" => Set.new
    }
  end
  if File.exist?(path)
    File.readlines(path, chomp: true).each do |line|
      tools = line.scan(/`(clockify_[^`]+)`/).flatten
      next if tools.empty?

      bucket = coverage_bucket_for_text(line)
      tools.each do |tool|
        tool_meta[tool]["evidence"] << "mcp-catalog"
        tool_meta[tool]["evidence"] << bucket if bucket
        tool_meta[tool]["statuses"] << bucket if bucket
        tool_meta[tool]["notes"] << line.gsub(/\s+/, " ")[0, 240]
      end

      line.scan(/\b(GET|POST|PUT|PATCH|DELETE)\s+(https:\/\/(?:api|reports)\.clockify\.me(?:\/api)?\/v1)?(\/[^`\s|,)]+)/i) do |method, host, op_path|
        tools.each { |tool| mapping[[method.downcase, normalize_path("#{host}#{op_path}")]] << tool }
      end
      line.scan(/\b(GET|POST|PUT|PATCH|DELETE)\s+(\/[^`\s|,)]+)/i) do |method, op_path|
        tools.each { |tool| mapping[[method.downcase, normalize_path(op_path)]] << tool }
      end
    end
  end

  risks = {}
  catalog_path = File.join(options[:repo_root], "docs/tool-catalog.json")
  if File.exist?(catalog_path)
    catalog = JSON.parse(File.read(catalog_path))
    catalog_tools(catalog).each do |tool|
      risks[tool["name"]] = Array(tool["risk_class"])
      method = tool["method"].to_s.downcase
      tool_path = tool["path"].to_s
      next unless METHODS.include?(method) && !tool_path.empty?

      normalized_path = normalize_path(tool_path)
      mapping[[method, normalized_path]] << tool["name"]
      tool_meta[tool["name"]]["evidence"] << "mcp-catalog"
      tool_meta[tool["name"]]["notes"] << "Tool catalog maps #{tool["name"]} to #{method.upcase} #{normalized_path}"
    end
  end
  normalized_meta = {}
  tool_meta.keys.sort.each do |tool|
    normalized_meta[tool] = {
      "evidence" => tool_meta[tool]["evidence"].to_a.sort,
      "statuses" => tool_meta[tool]["statuses"].to_a.sort,
      "notes" => tool_meta[tool]["notes"].to_a.sort
    }
  end
  [mapping.transform_values { |set| set.to_a.sort }, risks, normalized_meta]
end

def catalog_contract_errors(catalog)
  errors = []
  errors << "catalog must use top-level tools array" unless catalog["tools"].is_a?(Array)
  errors << "catalog must not use legacy tier1/tier2 top-level shape" if catalog.key?("tier1") || catalog.key?("tier2")
  errors << "catalog tools array must not be empty" if Array(catalog["tools"]).empty?
  errors
end

def catalog_tools(catalog)
  errors = catalog_contract_errors(catalog)
  abort(errors.join("\n")) unless errors.empty?

  catalog["tools"]
end

def coverage_bucket_for_text(text)
  lowered = text.to_s.downcase
  return "permission-gated" if lowered.match?(/permission|forbidden|plan|paid|subscription|owner|reviewed each surface/)
  return "workspace-state-limited" if lowered.match?(/workspace-state|cap-skipped|cap |limit|in-use|fixture|empty workspace/)
  return "unsupported" if lowered.match?(/unsupported|405|404|not-found|rejected/)
  return "live-success" if lowered.match?(/testlive|teste2e|live-|sacrificial-mutating|live-probed|scheduled workflow/)
  return "unit-only" if lowered.match?(/\bunit\b|dry-run|mock/)

  nil
end

def default_risk_for(method)
  case method
  when "get", "head", "options"
    ["read"]
  when "delete"
    ["destructive"]
  else
    ["write"]
  end
end

def raw_unit_notes(path)
  notes = []
  notes << "Money/rate fields use raw upstream integer units; no currency scaling is applied." if path.match?(%r{/(invoices|hourly-rate|cost-rate|expenses)})
  # VERIFIED LIVE 2026-08-07. Invoice item unitPrice is minor units scaled by a
  # further 100 (hundredths of a cent), so amount = unitPrice * quantity / 100 —
  # the older "preserved in raw upstream minor units" wording lost that factor.
  notes << "Invoice item unitPrice is minor units x100 (hundredths of a cent); amount = unitPrice * quantity / 100." if path.include?("/invoices/")
  # VERIFIED LIVE 2026-08-07. Percent fields are asymmetric: GET returns
  # tax/tax2/discount as percent x100 JSON floats (25% reads as 2500.0), while
  # PUT expects taxPercent/tax2Percent/discountPercent as plain percents.
  # Echoing the GET names back on a PUT silently zeroes them (200, no error).
  notes << "Invoice tax/tax2/discount read back as percent x100 floats; PUT takes taxPercent/tax2Percent/discountPercent as plain percents." if path.include?("/invoices")
  notes << "Expense amount and total fields preserve upstream scaling observed in live probes." if path.include?("/expenses")
  notes
end

def quirk_notes(path, method)
  notes = []
  notes << "Reports and shared-reports use the reports API host, not the main API host." if path.include?("/reports/") || path.include?("shared-reports")
  notes << "Expense create/update uses multipart form-data in live Clockify." if path.include?("/expenses") && %w[post put patch].include?(method)
  notes << "Archive active projects or clients before delete where Clockify requires it." if method == "delete" && path.match?(%r{/(projects|clients)/})
  notes << "Shared-report GET-by-id is bare /shared-reports/{id}; workspace-prefixed paths are used for list/create/update/delete." if path.include?("shared-reports")
  notes
end

def parameter_name(param)
  return nil unless param.is_a?(Hash)
  return param["name"] if param["in"] == "path"

  ref = param["$ref"].to_s
  return ref.split("/").last if ref.start_with?("#/components/parameters/")

  nil
end

# Tag normalization. Upstream sources spell the same domain several
# ways ("Project" + "Projects", "Webhook" + "Webhooks", etc.) which
# causes Fern (and any other tag-driven SDK generator) to emit
# duplicate resource groups. This map collapses each singular /
# casing variant into the canonical plural; all other tags pass
# through unchanged.
TAG_RENAMES = {
  "Project" => "Projects",
  "User" => "Users",
  "Webhook" => "Webhooks",
  "TimeEntry" => "Time Entries",
  "Time entry" => "Time Entries",
  "TimeOff" => "Time Off",
  # Singular tags that name a collection — collapse into the plural so
  # Fern emits one resource module per concept rather than singular +
  # plural siblings. Tracked under
  # addons-me/fern/spec/evidence/discrepancies.md → item 7.
  "Approval" => "Approvals",
  "Balance" => "Balances",
  "Client" => "Clients",
  "Policy" => "Policies",
  "Tag" => "Tags",
  # SharedReport spans a collection (list / get / create / update /
  # delete + a public bare GET) — five operations under a single
  # PascalCase tag. Plural canonicalisation keeps the SDK module
  # naming consistent with the other collection resources above.
  "SharedReport" => "Shared Reports"
}.freeze

# Path parameters whose route shares a parent with a literal sibling
# (e.g. /expenses/{expenseId} sits next to /expenses/categories).
# OpenAPI 3.0 has no first-class "literal wins" precedence hint, so
# generators flag the ambiguity. Real Clockify IDs are 24-char
# Mongo ObjectIDs, which can never collide with the literal segment,
# so stamping the canonical hex pattern unambiguously resolves the
# overlap. Add new entries only when a literal sibling actually
# exists; over-applying the pattern would falsely reject upstream
# IDs that might one day move off Mongo.
PATH_PARAM_PATTERNS = {
  "expenseId" => "^[0-9a-fA-F]{24}$",
  "invoiceId" => "^[0-9a-fA-F]{24}$",
  "assignmentId" => "^[0-9a-fA-F]{24}$"
}.freeze

# Operations that paginate via page + page-size query params.
# Live-probed against sandbox workspace 65b382b606de527a7ee2b60e on
# 2026-05-24. The Clockify API uses 1-based page numbers and a default
# page-size of 50 (max 200). Most return a bare top-level JSON array, but
# ~6 (expenses, invoices, invoice payments, project tasks, balances,
# time-off requests) return an object envelope; either way the Last-Page
# response header carries the boolean "is this the final page?" signal.
# Each entry below is an [http_method, canonical_path] pair —
# match by exact pair to avoid colliding with non-paginated GETs
# (e.g. POST /workspaces/{workspaceId}/expenses with the same path).
# Adding a new entry must be backed by a live probe captured in
# addons-me/fern/spec/evidence/probes/.
PAGINATED_LIST_OPS = Set.new([
  ["get", "/workspaces/{workspaceId}/approval-requests"],
  ["get", "/workspaces/{workspaceId}/clients"],
  ["get", "/workspaces/{workspaceId}/custom-fields"],
  ["get", "/workspaces/{workspaceId}/expenses"],
  ["get", "/workspaces/{workspaceId}/expenses/categories"],
  ["get", "/workspaces/{workspaceId}/holidays"],
  ["get", "/workspaces/{workspaceId}/invoices"],
  ["get", "/workspaces/{workspaceId}/invoices/{invoiceId}/payments"],
  ["get", "/workspaces/{workspaceId}/projects"],
  ["get", "/workspaces/{workspaceId}/projects/{projectId}/custom-fields"],
  ["get", "/workspaces/{workspaceId}/projects/{projectId}/tasks"],
  ["get", "/workspaces/{workspaceId}/scheduling/assignments/all"],
  ["get", "/workspaces/{workspaceId}/tags"],
  ["get", "/workspaces/{workspaceId}/time-entries/status/in-progress"],
  ["get", "/workspaces/{workspaceId}/time-off/balance/policy/{policyId}"],
  ["get", "/workspaces/{workspaceId}/time-off/balance/user/{userId}"],
  ["get", "/workspaces/{workspaceId}/time-off/policies"],
  ["get", "/workspaces/{workspaceId}/user-groups"],
  ["get", "/workspaces/{workspaceId}/user/{userId}/time-entries"],
  ["get", "/workspaces/{workspaceId}/users"],
  ["get", "/workspaces/{workspaceId}/users/{userId}/managers"]
]).freeze

PAGE_PARAM_DEFAULT = {
  "in" => "query",
  "name" => "page",
  "required" => false,
  "description" => "1-based page index. Default 1.",
  "schema" => {
    "type" => "integer",
    "format" => "int32",
    "default" => 1,
    "minimum" => 1
  }
}.freeze

PAGE_SIZE_PARAM_DEFAULT = {
  "in" => "query",
  "name" => "page-size",
  "required" => false,
  "description" => "Page size (number of items per page). Default 50; maximum 200.",
  "schema" => {
    "type" => "integer",
    "format" => "int32",
    "default" => 50,
    "minimum" => 1,
    "maximum" => 200
  }
}.freeze

# Operations that emit a `Last-Page: true|false` response header.
# Live-audited 2026-05-25 against sandbox workspace
# 65b382b606de527a7ee2b60e — see
# addons-me/fern/spec/evidence/discrepancies.md →
# `pagination.last-page-header.live-audit-2026-05-25`. 18 of the 21
# operations in PAGINATED_LIST_OPS emit the header consistently;
# probed both with results-available (page=1, page-size=2) which
# returned `last-page: false`, AND with results-exhausted (page=999,
# page-size=2) which returned `last-page: true` and a 0-item array.
# Three operations do NOT emit the header (custom-fields workspace
# + project scopes, and holidays); they also ignore page-size on the
# live server and return their full collection regardless of paging
# query params. The wrapper layer in
# addons-me/fern/wrapper/iter.ts uses this annotation (along with
# the existing `Last-Page` header probe at runtime) to short-circuit
# pagination when the server has acknowledged we've reached the end.
LAST_PAGE_HEADER_OPS = Set.new([
  ["get", "/workspaces/{workspaceId}/approval-requests"],
  ["get", "/workspaces/{workspaceId}/clients"],
  ["get", "/workspaces/{workspaceId}/expenses"],
  ["get", "/workspaces/{workspaceId}/expenses/categories"],
  ["get", "/workspaces/{workspaceId}/invoices"],
  ["get", "/workspaces/{workspaceId}/invoices/{invoiceId}/payments"],
  ["get", "/workspaces/{workspaceId}/projects"],
  ["get", "/workspaces/{workspaceId}/projects/{projectId}/tasks"],
  ["get", "/workspaces/{workspaceId}/scheduling/assignments/all"],
  ["get", "/workspaces/{workspaceId}/tags"],
  ["get", "/workspaces/{workspaceId}/time-entries/status/in-progress"],
  ["get", "/workspaces/{workspaceId}/time-off/balance/policy/{policyId}"],
  ["get", "/workspaces/{workspaceId}/time-off/balance/user/{userId}"],
  ["get", "/workspaces/{workspaceId}/time-off/policies"],
  ["get", "/workspaces/{workspaceId}/user-groups"],
  ["get", "/workspaces/{workspaceId}/user/{userId}/time-entries"],
  ["get", "/workspaces/{workspaceId}/users"],
  ["get", "/workspaces/{workspaceId}/users/{userId}/managers"]
]).freeze

def normalize_op_tags!(op)
  return unless op.is_a?(Hash) && op["tags"].is_a?(Array)

  op["tags"] = op["tags"].map { |t| TAG_RENAMES.fetch(t.to_s, t) }.uniq
end

def stamp_path_param_patterns!(op)
  return unless op.is_a?(Hash) && op["parameters"].is_a?(Array)

  op["parameters"].each do |param|
    next unless param.is_a?(Hash) && param["in"] == "path"

    pattern = PATH_PARAM_PATTERNS[param["name"].to_s]
    next unless pattern

    schema = (param["schema"] ||= {"type" => "string"})
    schema["pattern"] ||= pattern
  end
end

# Ensure paginated list operations declare the page + page-size query
# parameters. Idempotent: pre-existing page / page-size parameters in
# upstream sources are kept as-is (some declare type:string with
# default '0', some declare int32 with default 1 — both are accepted
# by the live API). Only missing names are appended with the canonical
# integer-typed shape.
#
# Note: this function INTENTIONALLY does not stamp x-fern-pagination.
# Most Clockify list endpoints return bare top-level JSON arrays with no
# envelope object — e.g. GET /workspaces/{wsId}/tags responds with
# [{...},{...}] not {"results":[...]} — though ~6 (expenses, invoices,
# invoice payments, project tasks, balances, time-off requests) return an
# object envelope instead. Either way, Fern's offset-pagination
# annotation requires `results` to be a dot-delimited sub-path of the
# response body (e.g. `$response.results`); bare arrays are rejected
# at fern generate time with errors like:
#   Pagination configuration for endpoint X specifies 'results'
#   $response.body, which is not a valid 'results' type.
# Tested 2026-05-24 against fern CLI 5.37.9. The page + page-size
# params themselves are still a real spec improvement (the live API
# supports them but the upstream source spec omits them on most of the
# 21 list operations); a hand-written iterator helper in the SDK
# wrapper picks up the slack until Fern adds bare-array support
# (tracked in addons-me/fern/spec/evidence/discrepancies.md →
# fern.x-fern-pagination.bare-array-unsupported).
def ensure_pagination!(op, method, path, params_components = {})
  return unless PAGINATED_LIST_OPS.include?([method.to_s, path.to_s])

  params = (op["parameters"] ||= [])
  # Resolve $ref param names too, so a surviving $ref page / page-size param
  # (now kept by ensure_path_parameters!) suppresses the inline append instead
  # of yielding a duplicate page parameter.
  param_names = params.map { |p| resolve_param_field(p, params_components, "name").to_s }
  params << deep_copy(PAGE_PARAM_DEFAULT) unless param_names.include?("page")
  params << deep_copy(PAGE_SIZE_PARAM_DEFAULT) unless param_names.include?("page-size")
end

# Stamp the Clockify-specific `x-clockify-last-page-header` extension
# on operations that emit a `Last-Page` response header (audit
# evidence in addons-me/fern/spec/evidence/discrepancies.md → the
# `pagination.last-page-header.live-audit-2026-05-25` entry). The
# wrapper's iterAll / iterPages helpers read this annotation (and
# inspect the raw response headers at runtime) to stop walking
# pages as soon as the server signals it has none left — more
# robust than the legacy "items.length < pageSize" heuristic that
# fails when a final page coincidentally fills.
def stamp_last_page_header!(op, method, path)
  return unless LAST_PAGE_HEADER_OPS.include?([method.to_s, path.to_s])

  op["x-clockify-last-page-header"] = true
end

# NOTE 2026-05-24: a `stamp_sdk_method_name!` heuristic was prototyped
# here that derived CRUDL verbs (list / get / create / update / delete /
# partialUpdate / archive) from each operation's method + URL shape and
# stamped them as `x-fern-sdk-method-name`. It applied to 135 of 193
# operations after one regen — but ALSO caused Fern CLI 5.37.9 to drop
# 12 entire resource modules from the generated TypeScript SDK
# (tags, holidays, expenses, expenseCategories, expenseReport, files,
# memberProfiles, reports, sharedReport, timeOffPolicies,
# auditLogReport, entityChangesExperimental). The IR (intermediate
# representation) retained all 31 services, but the TS generator
# container silently emitted only 19 resource modules. fern check
# reported no warnings or errors. The drop reproduced with the
# heuristic enabled and stopped reproducing the moment the stamp
# call was removed from the per-op finalization loop. Root cause
# uncertain; possibly an interaction with Fern's IR-level name-
# mangling for tag groups that already collide with type names
# (e.g. `TagDto` exists, so `Tags` module emission is suppressed).
# Tracked in addons-me/fern/spec/evidence/discrepancies.md →
# fern.x-fern-sdk-method-name.drops-resource-modules. Re-enable only
# after the Fern interaction is understood — until then, callers get
# the upstream operationId-derived method names (long but stable).

# Explicit, opt-in CRUDL method names. Each entry maps an
# [http_method, canonical_path] pair to a `{group, name}` pair stamped
# as `x-fern-sdk-group-name` + `x-fern-sdk-method-name`. Both keys are
# required: stamping `method-name` alone hoists the method to the root
# client (e.g. `client.list()` instead of `client.tags.list()`), which
# also empties the resource module it was hoisted from — the same
# silent-module-drop behaviour that derailed the 2026-05-24 attempt
# (see addons-me/fern/spec/evidence/discrepancies.md →
# fern.x-fern-sdk-method-name.drops-resource-modules). Bisect
# strategy: add one entry at a time, run the full gate chain +
# `fern generate --group ts --local --force`, and confirm the
# generated TS SDK still emits all 31 resource modules
# (`output/ts-sdk/api/resources/`) AND that the stamped method
# appears under `client.<group>.<name>(...)`. Stop expanding the
# moment something drops. The hash is intentionally not a heuristic —
# each entry is a deliberate, reviewed call.
