# clockify-mcp: local-stdio profile
# -----------------------------------------------------------------------------
# Single-user local stdio server. Intended for IDE / CLI use: spawn the
# binary with MCP_PROFILE=local-stdio (or the --profile=local-stdio flag)
# and talk to it over stdin/stdout. No control plane, no auth, no HTTP
# listener. The profile default is safe_core for trusted local
# automation; override to time_tracking_safe for exploratory AI-facing
# personal testing.
#
# Apply via:
#   source env.local-stdio.example && clockify-mcp
# Or equivalently:
#   clockify-mcp --profile=local-stdio
#
# See docs/deploy/profile-local-stdio.md for the profile rationale.

MCP_PROFILE=local-stdio

# REQUIRED: Your Clockify API key. Used by every tool call.
CLOCKIFY_API_KEY=your-api-key

# Recommended: pin the one workspace this API key should use. Auto-detect
# only when the key can see exactly one workspace.
CLOCKIFY_WORKSPACE_ID=your-workspace-id

# Recommended for AI-facing personal testing. Use safe_core only when the
# local client should create projects, clients, tags, or tasks.
CLOCKIFY_POLICY=time_tracking_safe

# Optional: fail closed if a report call materializes too many raw entries.
# Totals-only reports should prefer include_entries=false.
# CLOCKIFY_REPORT_MAX_ENTRIES=10000

# Optional: IANA timezone for relative-time parsing (e.g. "today").
# CLOCKIFY_TIMEZONE=Europe/Belgrade

# Optional: human-readable text logs to stderr.
# MCP_LOG_FORMAT=text
# MCP_LOG_LEVEL=info
